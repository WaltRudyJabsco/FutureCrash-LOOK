[Unit]
Description=Future Crash + LOOK OpenJev Decision Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/open-jev
ExecStart=%h/.local/share/open-jev/.venv/bin/python -m jev.server --checkpoint %h/.local/share/open-jev/models/Open-Jev-2B/package/checkpoint --device cuda:0 --max-length 4096 --batch-size 1 --no-prefix-cache --host 127.0.0.1 --port 8791
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
