<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.futurecrash.look.recovery-send</string>
<key>ProgramArguments</key><array>
<string>__HOME__/.local/bin/fcl-recovery</string><string>send</string><string>--due</string><string>__DESTINATION_USER_AT_HOST__</string>
</array>
<key>StartInterval</key><integer>3600</integer>
<key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>__HOME__/.local/share/future-crash-look/recovery-send.log</string>
<key>StandardErrorPath</key><string>__HOME__/.local/share/future-crash-look/recovery-send.log</string>
<key>Umask</key><integer>63</integer>
</dict></plist>
