def _load_feedback():
    data={"sound":False,"motion":"subtle"}
    try:
        loaded=json.loads(FEEDBACK_FILE.read_text(encoding="utf-8"))
        if isinstance(loaded,dict):
            data["sound"]=bool(loaded.get("sound",False))
            motion=str(loaded.get("motion","subtle")).lower()
            if motion in {"off","subtle","normal"}:
                data["motion"]=motion
    except (OSError,ValueError,TypeError):
        pass
    return data


def _save_feedback(data):
    CONFIG_DIR.mkdir(parents=True,exist_ok=True)
    payload={
        "sound":bool(data.get("sound",False)),
        "motion":str(data.get("motion","subtle")) if str(data.get("motion","subtle")) in {"off","subtle","normal"} else "subtle",
    }
    tmp=FEEDBACK_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload,indent=2)+"\n",encoding="utf-8")
    try: os.chmod(tmp,0o600)
    except OSError: pass
    tmp.replace(FEEDBACK_FILE)


def _tone_file(kind):
    """Generate tiny synthesized feedback tones; no bundled audio assets required."""
    cache=STATE_DIR/"feedback"
    cache.mkdir(parents=True,exist_ok=True)
    path=cache/f"{kind}.wav"
    if path.exists():
        return path
    spec={
        "accept":(660,0.045,0.13),
        "complete":(880,0.075,0.15),
        "notify":(740,0.060,0.13),
        "error":(220,0.090,0.16),
    }
    freq,duration,amp=spec.get(kind,spec["accept"])
    rate=22050
    frames=max(1,int(rate*duration))
    try:
        with wave.open(str(path),"wb") as wav:
            wav.setnchannels(1); wav.setsampwidth(2); wav.setframerate(rate)
            buf=bytearray()
            for i in range(frames):
                # Short fade keeps terminal feedback from sounding clicky.
                fade=min(1.0,i/(rate*.008),max(0.0,(frames-i)/(rate*.012)))
                sample=int(32767*amp*fade*math.sin(2*math.pi*freq*i/rate))
                buf.extend(struct.pack("<h",sample))
            wav.writeframes(bytes(buf))
        return path
    except OSError:
        return None


def _play_feedback_sound(kind):
    path=_tone_file(kind)
    if not path:
        return
    player=None
    args=[]
    if platform.system()=="Darwin" and shutil.which("afplay"):
        player=shutil.which("afplay"); args=[player,str(path)]
    elif shutil.which("paplay"):
        player=shutil.which("paplay"); args=[player,str(path)]
    elif shutil.which("aplay"):
        player=shutil.which("aplay"); args=[player,"-q",str(path)]
    if not player:
        return
    try:
        subprocess.Popen(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    except OSError:
        pass


def _feedback(kind="accept", label=""):
    """Finite, optional feedback. Never animates or sounds in piped output."""
    cfg=_load_feedback()
    if not sys.stdout.isatty():
        return
    if cfg.get("sound"):
        _play_feedback_sound(kind)
    motion=cfg.get("motion","subtle")
    if motion=="off":
        return

    glyphs={
        "accept":("·","◆","·"),
        "complete":("·","◈","✓"),
        "notify":("·","◐","●"),
        "error":("·","×","!"),
    }.get(kind,("·","◆","·"))
    code={"accept":"36","complete":"32","notify":"36","error":"33"}.get(kind,"36")
    frames=glyphs if motion=="normal" else (glyphs[1],glyphs[-1])
    delay=.045 if motion=="normal" else .035
    suffix=f" {_c(label,'2')}" if label else ""
    for frame in frames:
        sys.stdout.write(f"\r\033[2K{_c(frame,code)}{suffix}")
        sys.stdout.flush()
        time.sleep(delay)
    sys.stdout.write("\r\033[2K")
    sys.stdout.flush()


def _feedback_command(args):
