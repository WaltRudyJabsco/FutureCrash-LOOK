def _human_size(size):
    if size < 1024: return f"{size} B"
    if size < 1024**2: return f"{size/1024:.1f} KB"
    if size < 1024**3: return f"{size/1024**2:.1f} MB"
    return f"{size/1024**3:.1f} GB"


def _file_preview_lines(p, kind):
    """Return a generous but bounded preview for the interactive file card."""
    suffix=p.suffix.lower()
    textish = (
        kind.startswith('ASCII') or 'text' in kind.lower() or 'script' in kind.lower()
        or suffix in {'.md','.txt','.py','.js','.ts','.tsx','.jsx','.json','.toml','.yaml','.yml',
                      '.html','.css','.sh','.zsh','.c','.h','.cpp','.rs','.go','.lua','.sql','.csv'}
    )
    if textish and p.stat().st_size <= 2_000_000:
        try:
            lines=p.read_text(encoding='utf-8',errors='replace').splitlines()
            return ["", "  PREVIEW"] + ["  "+line[:220] for line in lines[:400]] + (
                [f"  … {len(lines)-400} more lines"] if len(lines)>400 else []
            )
        except OSError:
            return []
    if suffix=='.pdf' and shutil.which('pdftotext'):
        try:
            r=subprocess.run(['pdftotext','-f','1','-l','3','-layout',str(p),'-'],
                             capture_output=True,text=True,timeout=3)
            lines=[x.rstrip() for x in r.stdout.splitlines() if x.strip()]
            if lines:
                return ["", "  PDF PREVIEW"] + ["  "+line[:220] for line in lines[:250]]
        except (OSError,subprocess.SubprocessError):
            pass
    return []


def _copy_path(path):
