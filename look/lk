        headers={"Content-Type":"application/json"},method="POST"
    )
    with urllib.request.urlopen(request) as response:
        for raw in response:
            if not raw.strip(): continue
            yield json.loads(raw)

def ollama_chat(force_search=False, initial_prompt=None, allow_start=True, host_override=None, host_name=None, access_profile=None, selected_paths=None, workspace_override=None, one_shot=False):
    """Minimal local chat; optional first prompt and web-search mode."""
    import json
    import urllib.request

    base = _ollama_base(host_override)
    profile=(access_profile or _load_lo_profile()).lower()
    if profile not in LO_PROFILES:
        print(f"LOOK OLLAMA · unknown access profile: {profile}")
        return 1
    if profile=="unsafe" and not _confirm_unsafe_session():
        print("· cancelled")
        return 0

    running = _ensure_ollama_server(base, allow_start=(allow_start and _is_local_ollama(base)))
    if running is None:
        print("LOOK OLLAMA · server unavailable")
        return 1

    # Model preference is global, but availability belongs to the selected host.
    # Never send a model name to a remote Ollama that does not actually have it.
    preferred = _preferred_ollama_model()
    running_names = [(m.get("name") or m.get("model") or "").strip() for m in (running or [])]
    running_names = [name for name in running_names if name]
    try:
        installed = _ollama_tags(base)
    except Exception:
        installed = []
    installed_names = [(m.get("name") or m.get("model") or "").strip() for m in installed]
    installed_names = [name for name in installed_names if name]

    if preferred in installed_names:
        model = preferred
    elif running_names:
        model = running_names[0]
    elif installed_names:
        model = installed_names[0]
    else:
        print(f"LOOK OLLAMA · {shown_host if 'shown_host' in locals() else _ollama_host_name(base)} is reachable, but has no models installed")
        return 1
    resident = model in running_names
    model_caps=_ollama_capabilities(base, model)
    supports_thinking=bool(model_caps and "thinking" in model_caps)

    workspace = Path(workspace_override).expanduser().resolve() if workspace_override else Path.cwd().resolve()
    selected_paths=[Path(p).expanduser().resolve() for p in (selected_paths or [])]

    has_web = bool(os.environ.get("OLLAMA_API_KEY"))
    mode = "LOOK OLLAMA SEARCH" if force_search else "LOOK OLLAMA"
    web_state = "required" if force_search else ("available" if has_web else "off")
    shown_host=host_name or _ollama_host_name(base)
    print(f"{mode} · {model} · {workspace}")
    print(f"host · {shown_host} · {base}")
    print(f"access · {profile.upper()} · personality · {_load_personality()} · thinking · {_load_thinking()}/{_load_think_display()}")
    if selected_paths:
        print(f"context · {len(selected_paths)} selected path{'s' if len(selected_paths)!=1 else ''}")
    if not resident:
        print(f"model · idle · loads on first prompt")
    print(f"web · {web_state} · Ctrl-D to exit · Ctrl-C cancels work\n")

    web_tool = {
        "type": "function",
        "function": {
            "name": "web_search",
            "description": "Search the web for current or externally verifiable information. Use this when the answer depends on recent events, news, current facts, or information you are uncertain about.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "The web search query"}
                },
                "required": ["query"],
            },
        },
    }

    memory = _load_memory()
    messages = [
        {"role": "system", "content": _workspace_snapshot(workspace)},
        {"role": "system", "content": (
            "You are LOOK Ollama, running inside the user's LOOK Shell terminal interface. "
            "Keep answers concise and terminal-readable. Use lightweight Markdown naturally when it improves clarity: "
            "# / ## / ### headings, **bold**, *italics*, bullets, inline code, fenced code blocks, and Markdown links. "
            "LOOK renders these with terminal styling, and http/https Markdown links may be clickable in supporting terminals. "
            "Do not over-format simple answers. "
            "Casual conversation, personal statements, preferences, and general-knowledge questions are valid on their own. "
            "Do NOT search or inspect the workspace merely because file tools are available. Tool availability is not a reason to use a tool. "
            "Use workspace tools only when the user actually refers to files, code, the current project, this folder/here, or asks for local inspection/action. "
            "Use relevant user memories naturally when they help, but do not expose importance scores, memory IDs, or say 'your memory says' unless the user asks about memory internals. "
            "Persistent memory is maintained asynchronously by LOOK outside the conversational tool list. "
            "If the user explicitly asks you to remember something, acknowledge that intent naturally; do not claim memory is limited to the current session merely because no memory tool is exposed in chat. "
            "When the user refers to 'this folder', 'here', local files, or the current project, "
            "use the workspace context and file tools instead of guessing. "
            "You may list files, read bounded text files, search filenames/text, create or intentionally modify UTF-8 text, "
            "and use bounded copy_path, move_path, remove_path, make_directory, and create_text_files tools inside the workspace. ""When the user asks for several new text files, prefer create_text_files so the whole request is one verified operation. "
            "When the user asks to copy, duplicate, clone, or back up an existing path, ALWAYS use copy_path; never reconstruct it with read_file + write_file. "
            "When the user asks to move or rename an existing path, use move_path. When explicitly asked to remove one, use remove_path. "
            "Use write_file only for intentional textual creation or editing. Only mutate files when the user explicitly asks. "
            "Do not claim to have read or changed a file unless the corresponding tool supplied or confirmed it. "
            "CRITICAL EXECUTION CONTRACT: when the user explicitly asks you to create, write, copy, move, rename, edit, or remove local files/folders, you must CALL the appropriate filesystem tool before reporting success. Planning or describing a tool call is not execution. Never say an operation succeeded unless a tool result confirms it. "
            "Do not claim filesystem access outside the starting LOOK workspace. "
            "Use canonical information edges before generic search whenever they fit: weather=WEATHER, place_lookup=PLACE, wikipedia=WIKI, wikidata=DATA, papers=PAPERS, archive=ARCHIVE. You MUST call weather for current weather, temperature, rain, wind, or forecasts; never answer those from model memory. Use WIKI for readable stable background, DATA for structured entity facts, PAPERS for bibliographic/DOI questions, and ARCHIVE when the historical object or primary artifact matters. Canonical tool results include an epistemic receipt: edge, source, confidence, as_of when available, retrieved_at, and source_url. Preserve that provenance compactly in factual answers. DIRECT means the canonical source returned the fact; DERIVED means LOOK computed it from canonical data; SEARCHED means general web results were interpreted; MODEL means no external verification. Never invent numerical confidence percentages. If web_search is available, use it when current or externally verifiable information is needed and no canonical tool fits; "
            "when citing or recommending web material, always preserve the exact http/https URL supplied by the search result and emit a complete Markdown link in the form [descriptive label](https://actual-url). Never emit citation placeholders such as [source], [1], or a site name styled like a link without an actual URL. Never invent a URL from a site name."
        )},
    ]
    if selected_paths:
        rows=[]
        for p in selected_paths[:200]:
            try:
                rel=p.relative_to(workspace)
                shown=str(rel) if str(rel)!="." else p.name
            except ValueError:
                shown=str(p)
            suffix="/" if p.is_dir() else ""
            rows.append(f"- {shown}{suffix}")
        messages.append({
            "role":"system",
            "content":(
                "SELECTED PATH CONTEXT\n"
                "The operator explicitly handed these paths to this LO session as the current working set. "
                "Treat them as relevant context, but do not assume their contents: use read_file/list_files/search_files as needed. "
                "Do not modify them unless the operator explicitly asks.\n"
                + "\n".join(rows)
            )
        })

    capability_notes={
        "conservative": (
            "ACCESS PROFILE: CONSERVATIVE. You may inspect/search/read the starting workspace and use web search when available. "
            "Mutation and shell execution tools are intentionally absent."
        ),
        "workspace": (
            "ACCESS PROFILE: WORKSPACE. You may use LOOK's bounded filesystem tools inside the starting workspace. "
            "Arbitrary shell execution is intentionally unavailable."
        ),
        "power": (
            "ACCESS PROFILE: POWER. You may use bounded workspace tools and run_command for computer-level work. "
            "Every shell command requires user confirmation. Prefer inspection before mutation and briefly explain destructive/system-wide actions."
        ),
        "unsafe": (
            "ACCESS PROFILE: UNSAFE. The user explicitly enabled unrestricted shell command execution for this session. "
            "Use run_command when needed, including system-wide work, package installation, builds, cleanup, and administration. "
            "Avoid unnecessary destructive actions and report command results accurately."
        ),
    }
    messages.append({"role":"system","content":capability_notes[profile]})
    thinking_mode=_load_thinking()
    thinking_notes={
        "light":"THINKING DEPTH: LIGHT. Give fast, direct answers.",
        "adaptive":"THINKING DEPTH: ADAPTIVE. Use deliberate reasoning only when the task actually needs it.",
        "deep":"THINKING DEPTH: DEEP. Deliberate carefully on substantive work without repetitive self-commentary.",
    }
    messages.append({"role":"system","content":thinking_notes[thinking_mode]})

    memory_context = _memory_context(memory)
    if memory_context:
        messages.append({"role": "system", "content": memory_context})
    recent_context=_recent_context()
    if recent_context:
        messages.append({"role":"system","content":recent_context})

    base_message_count=len(messages)
    pending_prompt = (initial_prompt or "").strip()
    while True:
        if pending_prompt:
            prompt=pending_prompt
            pending_prompt=""
            print(f"{_ansi_label('you ›', '36')} {prompt}")
        else:
            try:
                prompt = input(_ansi_label("you ›", "36") + " ").strip()
            except EOFError:
                print()
                return 0
            except KeyboardInterrupt:
                print("\n· cancelled")
                continue

        if not prompt:
            continue

        messages=_trim_lo_history(messages, base_message_count)
        messages.append({"role": "user", "content": prompt})

        # Search mode is deliberately deterministic: search first, then answer.
        if force_search:
            if not has_web:
                print("search › OLLAMA_API_KEY is not set\n")
                messages.pop()
                continue
            try:
                print(f"{_ansi_label('search ›', '33')} {prompt}")
                with _activity("searching"):
                    result = _ollama_web_search(prompt)
                messages.append({
                    "role": "system",
                    "content": "Current web search results for the user's latest question:\n" + _search_text(result) +
                               "\nUse these results when answering. When citing or recommending any result, preserve the exact URL from the result and emit a complete Markdown link in the form [descriptive label](https://actual-url). Never emit [source], [1], or a site name as a pseudo-link without an actual URL, and never invent a URL.",
                })
            except KeyboardInterrupt:
                print("\n· cancelled\n")
                messages.pop()
                continue
            except Exception as exc:
                print(f"search › {exc}\n")
                messages.pop()
                continue

        # Normal mode exposes tools to the model, but explicit mutations are also
        # enforced by the host so prose can never masquerade as execution.
        mutation_required=(profile!="conservative" and _lo_requires_filesystem_action(prompt))
        mutation_attempted=False
        mutation_repair_sent=False
        for _ in range(5):
            runtime=_lo_runtime_policy(thinking_mode, prompt)
            payload_obj = {
                "model": model,
                "messages": messages,
                "stream": False,
                "options": {
                    "num_ctx": LO_CONTEXT_TOKENS,
                    "num_predict": runtime["num_predict"],
                    "temperature": runtime["temperature"],
                },
            }
            if supports_thinking:
                payload_obj["think"]=runtime["think"]
            tools = _lo_tools(profile)
            if has_web and not force_search:
                tools.append(web_tool)
            payload_obj["tools"] = tools

            try:
                aggregate={"role":"assistant","content":"","thinking":"","tool_calls":[]}
                roller=_RollingThinking(_load_think_display())
                for event in _ollama_stream_chat(base,payload_obj):
                    fragment=event.get("message",{}) or {}
                    thought=str(fragment.get("thinking") or "")
                    content=str(fragment.get("content") or "")
                    if thought:
                        aggregate["thinking"]+=thought
                        roller.feed(thought)
                    if content:
                        aggregate["content"]+=content
                    if fragment.get("tool_calls"):
                        aggregate["tool_calls"].extend(fragment.get("tool_calls") or [])
                roller.finish()
                result={"message":aggregate}
            except KeyboardInterrupt:
                print("\n· cancelled\n")
                messages.pop()
                break
            except Exception as exc:
                print(f"LOOK OLLAMA · {exc}")
                messages.pop()
                break

            message = result.get("message", {})
            tool_calls = message.get("tool_calls") or []
            if tool_calls:
                messages.append(message)
                for call in tool_calls:
                    function = call.get("function", {})
                    name = function.get("name", "")
                    args = function.get("arguments", {}) or {}
                    if isinstance(args, str):
                        try:
                            args=json.loads(args)
                        except Exception:
                            args={}

                    if name == "weather":
                        location=args.get("location","")
                        try:
                            print(f"{_ansi_label('weather ›', '36')} {location}")
                            with _activity("weather"):
                                tool_content=_weather_lookup(location)
                        except Exception as exc: tool_content=f"Weather lookup failed: {exc}"
                    elif name == "place_lookup":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('place ›', '36')} {query}")
                            with _activity("geocoding"):
                                tool_content=_place_lookup(query)
                        except Exception as exc: tool_content=f"Place lookup failed: {exc}"
                    elif name == "wikipedia":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('wiki ›', '35')} {query}")
                            with _activity("wikipedia"):
                                tool_content=_wikipedia_lookup(query)
                        except Exception as exc: tool_content=f"Wikipedia lookup failed: {exc}"
                    elif name == "wikidata":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('data ›', '35')} {query}")
                            with _activity("wikidata"):
                                tool_content=_wikidata_lookup(query)
                        except Exception as exc: tool_content=f"Wikidata lookup failed: {exc}"
                    elif name == "papers":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('papers ›', '36')} {query}")
                            with _activity("crossref"):
                                tool_content=_papers_lookup(query,args.get("rows",5))
                        except Exception as exc: tool_content=f"Papers lookup failed: {exc}"
                    elif name == "archive":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('archive ›', '33')} {query}")
                            with _activity("archive"):
                                tool_content=_archive_lookup(query,args.get("rows",5))
                        except Exception as exc: tool_content=f"Archive lookup failed: {exc}"
                    elif name == "web_search":
                        if not has_web or force_search:
                            tool_content = "Web search is unavailable in this session."
                        else:
                            query = args.get("query", prompt)
                            try:
                                print(f"{_ansi_label('search ›', '33')} {query}")
                                with _activity("searching"):
                                    search_result = _ollama_web_search(query)
                                tool_content = _search_text(search_result)
                            except Exception as exc:
                                tool_content = f"Web search failed: {exc}"
                    elif name in {"list_files", "read_file", "search_files", "write_file", "create_text_files", "copy_path", "move_path", "remove_path", "make_directory"}:
                        tool_content = _run_filesystem_tool(workspace, name, args)
                        if name in _LO_MUTATION_TOOLS:
                            mutation_attempted=True
                            print(f"{_ansi_label('file ›', '32')} {tool_content}")
                    elif name in {"list_processes","listening_ports","system_snapshot"}:
                        print(f"{_ansi_label('system ›','36')} {name.replace('_',' ')}")
                        with _activity("inspecting"):
                            tool_content=_run_system_inspection_tool(name,args)
                    elif name=="run_command":
                        if profile not in {"power","unsafe"}:
                            tool_content="Command execution is unavailable in this access profile."
                        else:
                            tool_content=_run_command_tool(workspace,args,profile)
                            print(f"{_ansi_label('command ›', '33')} {tool_content.splitlines()[0]}")
                    else:
                        tool_content = f"Unknown tool: {name}"

                    messages.append({
                        "role": "tool",
                        "tool_name": name,
                        "content": tool_content,
                    })
                continue

            answer = message.get("content", "").strip()

            if mutation_required and not mutation_attempted:
                if not mutation_repair_sent:
                    mutation_repair_sent=True
                    messages.append({
                        "role":"system",
                        "content":(
                            "EXECUTION REQUIRED. The user's latest request explicitly asks for a local filesystem change, "
                            "but you have not called any mutation tool yet. Do not explain or claim success. "
                            "Call the appropriate filesystem tool now. For several new text files, prefer create_text_files. "
                            "If a needed parent directory is missing, call make_directory first."
                        )
                    })
                    continue
                # Second prose-only completion is not allowed to become a false receipt.
                answer="I did not execute a filesystem mutation tool, so I have not changed any files."
                message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}

            messages.append(message)
            # Thinking was already presented live according to the selected display mode.
            final=_split_ollama_thinking(message)[1]
            if final:
                print(_ansi_label("lo ›","35")+" "+_ollama_markup(final)+"\n")
            else:
                print(_ansi_label("lo ›","35")+" "+_c("(no final response)","2")+"\n")
            _save_recent_exchange(prompt, answer)
            if _queue_memory_exchange(base, model, prompt, answer, profile):
                if sys.stdout.isatty():
                    print(_c("  · remembering in background", "2"))
            else:
                # If queueing ever fails, preserve memory rather than silently dropping it.
                with _activity("remembering"):
                    memory = _remember_exchange(base, model, memory, prompt, answer, profile)
            if one_shot:
                return 0
            break


def _c(text, code):
    """Semantic terminal color with a truecolor LOOK 3 presentation path."""
    if not sys.stdout.isatty():
        return str(text)

    classic=os.environ.get("LOOK_CLASSIC","").lower() in {"1","true","yes","on"}
    truecolor=(not classic and (
        os.environ.get("COLORTERM","").lower() in {"truecolor","24bit"}
        or os.environ.get("TERM_PROGRAM") in {"iTerm.app","Apple_Terminal","WezTerm","ghostty"}
    ))
    if not truecolor:
        return f"\033[{code}m{text}\033[0m"

    rgb={
        "36":(103,214,238), "1;36":(103,214,238),
        "32":(139,214,145), "1;32":(139,214,145),
        "33":(238,200,109),
        "31":(239,125,135),
    }
    if code=="2":
        return f"\033[38;2;128;139;154m{text}\033[0m"
    if code=="1":
        return f"\033[1m{text}\033[0m"
    color=rgb.get(code)
    if color:
        bold="\033[1m" if code.startswith("1;") else ""
        r,g,b=color
        return f"{bold}\033[38;2;{r};{g};{b}m{text}\033[0m"
    return f"\033[{code}m{text}\033[0m"


def _title(name, detail=''):
    tail=f"  {_c('· '+detail, '2')}" if detail else ''
    print(f"{_c(name, '1;36')}{tail}")


def _run_text(args, timeout=1.5):
    try:
        r=subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else ''
    except (OSError, subprocess.SubprocessError):
        return ''


def inspect_command(name):
    """Explain how a command resolves without changing the shell."""
    path=shutil.which(name)
    _title(name, 'command')
    if not path:
        print(f"  {_c('✗', '31')} not found on PATH")
        # zsh can know about aliases/functions that a child Python process cannot inspect directly.
        print(f"  {_c('hint', '33')} run: type -a {name}")
        return 1
    real=str(Path(path).resolve())
    print(f"  {_c('✓', '32')} executable  {path}")
    if real != path:
        print(f"  {_c('↗', '36')} resolves     {real}")
    try:
        st=Path(path).stat()
        mode=oct(st.st_mode & 0o777)
        print(f"  permissions {mode}")
    except OSError:
        pass
    matches=[]
    for folder in os.environ.get('PATH','').split(os.pathsep):
        candidate=Path(folder).expanduser()/name
        if candidate.exists() and os.access(candidate, os.X_OK):
            val=str(candidate)
            if val not in matches: matches.append(val)
    if len(matches)>1:
        print("  alternatives")
        for m in matches[:8]: print(f"    · {m}")
    return 0


def inspect_port(port):
    _title(str(port), 'port')
    found=''
    if shutil.which('lsof'):
        found=_run_text(['lsof','-nP',f'-iTCP:{port}','-sTCP:LISTEN'])
    elif shutil.which('ss'):
        found='\n'.join(x for x in _run_text(['ss','-ltnp']).splitlines() if f':{port} ' in x or f':{port}\n' in x)
    if found:
        print(found)
        return 0
    print(f"  {_c('·', '33')} no listening TCP process found")
    return 1


def inspect_git(path='.'):
    target=Path(path).expanduser().resolve()
    root=_run_text(['git','-C',str(target),'rev-parse','--show-toplevel'])
    _title('git', str(target))
    if not root:
        print(f"  {_c('·', '33')} not a Git repository")
        return 1
    branch=_run_text(['git','-C',root,'branch','--show-current']) or '(detached)'
    status=_run_text(['git','-C',root,'status','--short'])
    remote=_run_text(['git','-C',root,'remote','get-url','origin'])
    print(f"  root    {root}")
    print(f"  branch  {_c(branch, '36')}")
    if remote: print(f"  origin  {remote}")
    if status:
        lines=status.splitlines()
        print(f"  changes {_c(str(len(lines)), '33')}")
        for line in lines[:10]: print(f"    {line}")
        if len(lines)>10: print(f"    {_c('…', '2')} {len(lines)-10} more")
    else:
        print(f"  {_c('✓', '32')} clean")
    return 0


def inspect_project(path='.'):
    """Recognize a project and show likely actions; never executes them."""
    d=Path(path).expanduser().resolve()
    _title('run', str(d))
    if not d.is_dir():
        print(f"  {_c('✗', '31')} not a directory")
        return 1
    actions=[]; kinds=[]
    def has(name): return (d/name).exists()
    if has('package.json'):
        kinds.append('Node/Bun')
        try:
            import json
            scripts=json.loads((d/'package.json').read_text()).get('scripts',{})
            runner='bun run' if has('bun.lock') or has('bun.lockb') else 'npm run'
            for key in ('dev','start','test','build','serve'):
                if key in scripts: actions.append((key,f'{runner} {key}'))
        except Exception: pass
    if has('pyproject.toml') or has('requirements.txt') or has('setup.py'):
        kinds.append('Python')
        if has('pytest.ini') or (d/'tests').exists(): actions.append(('test','python -m pytest'))
        if has('main.py'): actions.append(('start','python main.py'))
        elif has('app.py'): actions.append(('start','python app.py'))
    if has('Cargo.toml'):
        kinds.append('Rust'); actions += [('run','cargo run'),('test','cargo test'),('build','cargo build')]
    if has('Makefile'):
        kinds.append('Make'); actions.append(('targets','make -n <target>'))
    if has('docker-compose.yml') or has('compose.yml') or has('compose.yaml'):
        kinds.append('Docker Compose'); actions.append(('start','docker compose up'),('stop','docker compose down'))
    if has('Dockerfile'):
        kinds.append('Docker'); actions.append(('build','docker build .'))
    if has('index.html'):
        kinds.append('web'); actions.append(('serve','python3 -m http.server'))
    if has('.git'): kinds.append('Git')
    if not kinds:
        print(f"  {_c('·', '33')} no recognized project markers")
        return 1
    print(f"  type    {' + '.join(dict.fromkeys(kinds))}")
    if actions:
        print("  actions")
        seen=set()
        for label,cmd in actions:
            if cmd in seen: continue
            seen.add(cmd); print(f"    {_c(f'{label:<10}', '36')} {cmd}")
    else:
        print(f"  {_c('·', '33')} project recognized; no obvious standard action")
    return 0


def _copy_value(value):
    try:
        if platform.system()=="Darwin" and shutil.which("pbcopy"):
            subprocess.run(["pbcopy"],input=str(value),text=True,check=True)
            return True
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy"],input=str(value),text=True,check=True)
            return True
        if shutil.which("xclip"):
            subprocess.run(["xclip","-selection","clipboard"],input=str(value),text=True,check=True)
            return True
    except (OSError,subprocess.SubprocessError):
        pass
    return False


def _read_tty_key(fd, timeout=None):
    if timeout is not None:
        ready,_,_=select.select([fd],[],[],timeout)
        if not ready:
            return ""
    ch=os.read(fd,1)
    if ch != b"\x1b":
        return ch.decode("utf-8","ignore")
    seq=bytearray(ch)
    while len(seq)<8:
        ready,_,_=select.select([fd],[],[],0.035)
        if not ready:
            break
        seq.extend(os.read(fd,1))
        if seq[-1:] in b"~ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz":
            break
    return {
        b"\x1b[A":"up",
        b"\x1b[B":"down",
        b"\x1b[5~":"pageup",
        b"\x1b[6~":"pagedown",
    }.get(bytes(seq),"esc")


def _select_values(title, rows):
    """Shared LOOK selector: browse, Enter to filter, arrows/J/K move, Y copies value."""
    if not rows:
        return 1
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        _title(title)
        for label,value in rows:
            print(f"  {label}  {value}")
        return 0

    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    query=""
    filtering=False
    idx=0
    notice=""
    try:
        tty.setcbreak(fd)
        while True:
            terms=query.casefold().split()
            visible=[
                row for row in rows
                if all(term in f"{row[0]} {row[1]}".casefold() for term in terms)
            ]
            if visible:
                idx=min(idx,len(visible)-1)
            else:
                idx=0

            terminal=shutil.get_terminal_size((100,30))
            height=max(8,terminal.lines)
            width=max(40,terminal.columns)
            usable=max(3,height-5)
            top=max(0,min(max(0,len(visible)-usable),idx-usable+1))
            page=visible[top:top+usable]

            sys.stdout.write("\033[2J\033[H")
            _title(title, f"{len(visible)} of {len(rows)}")
            for n,(label,value) in enumerate(page,start=top):
                mark=_c("›","1;36") if n==idx else " "
                raw_value=str(value)
                max_label=max(8,width-len(raw_value)-5)
                shown_label=str(label)
                if len(shown_label)>max_label:
                    shown_label=shown_label[:max(1,max_label-1)]+"…"
                value_text=_c(raw_value,"2")
                print(f"{mark} {shown_label}  {value_text}")

            if filtering:
                footer=(f"{_c('FILTER','1;36')} {query}█  "
                        f"{_c('↑↓ choose  Y copy  Enter done  Esc clear/back  q quit','2')}")
            else:
                footer=_c("↑↓ choose  Enter filter  Y copy  PgUp/PgDn page  Esc/q exit","2")
            if notice:
                footer += "  " + _c(notice,"33")
                notice=""
            print("\n"+footer,end="",flush=True)

            key=_read_tty_key(fd)
            if key in {"q","Q","\x03"}:
                break
            if key=="esc":
                if filtering and query:
                    query=""
                    idx=0
                    continue
                if filtering:
                    filtering=False
                    continue
                break
            if key in {"up","k"} and visible:
                idx=max(0,idx-1)
                continue
            if key in {"down","j"} and visible:
                idx=min(len(visible)-1,idx+1)
                continue
            if key=="pageup" and visible:
                idx=max(0,idx-usable)
                continue
            if key=="pagedown" and visible:
                idx=min(len(visible)-1,idx+usable)
                continue
            if key in {"y","Y"} and visible:
                notice="copied" if _copy_value(visible[idx][1]) else "clipboard unavailable"
                continue
            if key in {"\r","\n"}:
                filtering=not filtering
                continue
            if filtering and key in {"\x7f","\b"}:
                if query:
                    query=query[:-1]
                    idx=0
                continue
            if filtering and len(key)==1 and key.isprintable():
                query+=key
                idx=0
                continue
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)
        print()
    return 0



