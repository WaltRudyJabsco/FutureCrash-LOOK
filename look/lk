def _skill_is_too_specific(text):
    """Skills are reusable operating craft, never user/task history."""
    low=str(text or "").casefold()
    bad=(
        "the user ", "user prefers", "user likes", "user loves",
        "banana-test", "walrus-test", "the kinks", "the police",
        "3090", "current project", "this conversation", "this user",
        "remember that", "favorite band", "favourite band",
    )
    return any(x in low for x in bad)


def _sanitize_skill(text):
    clean=" ".join(_strip_reasoning_payload(text).split()).strip()
    if not clean or _looks_like_model_meta(clean) or _skill_is_too_specific(clean):
        return ""
    if len(clean) > 320:
        return ""
    return clean.rstrip(".")


def _extract_skill_candidate(base, model, user_text, assistant_text):
    """Ask whether this exchange taught LO reusable operating craft."""
    prompt=f"""Did this exchange reveal ONE reusable lesson that would make you a better
assistant on many future tasks?

Usually return NONE.

A skill is generalized operating craft, such as:
- inspect before modifying;
- preserve unrelated behavior during a surgical change;
- distinguish dependency failure from project failure;
- prefer a stable canonical location when installing a tool.

A skill is NOT:
- a fact/preference about this user;
- a filename, project-specific choice, model/host name, or conversation detail;
- a summary of what happened;
- praise or style mimicry;
- a rule already obvious from the existing assistant instructions.

Return exactly one line:
NONE
or:
SKILL|concise generalized lesson

No reasoning, headings, explanation, or <think> markup.
Maximum skill length: 40 words.

USER:
{user_text[:4000]}

ASSISTANT:
{assistant_text[:5000]}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"You review completed work for rare, genuinely reusable assistant craft. Usually answer NONE."},
            {"role":"user","content":prompt},
        ], num_ctx=4096, num_predict=96, think=False, temperature=0.1)
        final=_strip_reasoning_payload(raw).strip()
        if final.upper()=="NONE":
            return None
        if "\n" in final.strip():
            return None
        m=re.fullmatch(r"\s*SKILL\s*\|\s*(.+?)\s*",final,re.I)
        if not m:
