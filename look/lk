def _surface_key():
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return ""
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        return _read_tty_key(fd)
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)

def _surface_pause():
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return
    print(f"\n  {_c('[any key]', '2')} back")
    _surface_key()

def _surface_run(fn, *args):
    _surface_clear()
    try:
        fn(*args)
    except KeyboardInterrupt:
        pass
    _surface_pause()

