def _ollama_tags(base):
    import json, urllib.request
    with urllib.request.urlopen(base+"/api/tags", timeout=2) as response:
        return json.load(response).get("models", [])


def _ollama_post(base, endpoint, payload, timeout=120):
    import json, urllib.request
    data=json.dumps(payload).encode("utf-8")
    request=urllib.request.Request(
        base+endpoint, data=data,
        headers={"Content-Type":"application/json"}, method="POST"
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)


def _ollama_capabilities(base, model):
    """Return Ollama-declared capabilities, or None when this server cannot report them."""
    try:
        shown=_ollama_post(base, "/api/show", {"model":model}, timeout=8)
    except Exception:
        return None
    caps=shown.get("capabilities")
    if not isinstance(caps, list):
        return None
    return [str(cap).strip().lower() for cap in caps if str(cap).strip()]


def _load_ollama_model_prefs():
    try:
        data=json.loads(OLLAMA_MODELS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        data={}
    disabled=data.get("disabled",[])
    return {str(name) for name in disabled if str(name).strip()}


def _save_ollama_model_prefs(disabled):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp=OLLAMA_MODELS_FILE.with_suffix(".tmp")
    tmp.write_text(
        json.dumps({"disabled":sorted(disabled)}, indent=2)+"\n",
        encoding="utf-8",
    )
    os.chmod(tmp,0o600)
    tmp.replace(OLLAMA_MODELS_FILE)
    os.chmod(OLLAMA_MODELS_FILE,0o600)


def _ollama_set_model(base, model):
    """Unload resident models, preload the selected one, and remember the choice."""
    running=_ollama_ps(base)
    for item in running:
        name=(item.get("name") or item.get("model") or "").strip()
        if name and name != model:
            try:
                _ollama_post(base, "/api/generate", {"model":name, "keep_alive":0}, timeout=30)
            except Exception:
                pass

    # An empty generation request loads the model without asking it to answer.
    _ollama_post(base, "/api/generate", {"model":model, "prompt":"", "keep_alive":"10m"}, timeout=180)
    _save_preferred_ollama_model(model)
    return model


def _model_capability_label(caps):
    if caps is None:
        return "capabilities ?"
    useful=[c for c in ("tools","thinking","vision","embedding","completion") if c in caps]
    return " · ".join(useful) if useful else "text"


def _ollama_model_rows(base, names, resident, disabled):
    rows=[]
    preferred_name=_preferred_ollama_model()
    for name in names:
        caps=_ollama_capabilities(base,name)
        enabled=name not in disabled
        state=_c("✓","32") if enabled else _c("×","2")
        live=_c("●","32") if name in resident else " "
        preferred=_c("★","33") if name == preferred_name else " "
        padded=f"{name:<28}"
        shown_name=_c(padded,"1") if name == preferred_name else padded
        raw_label=_model_capability_label(caps)
        if raw_label=="capabilities ?":
            label=_c(raw_label,"2")
        else:
            parts=[]
            for cap in raw_label.split(" · "):
                code={"tools":"36","thinking":"35","vision":"33"}.get(cap,"2")
                parts.append(_c(cap,code))
            label=" · ".join(parts)
        # Raw name stays in field one; display decoration never affects parsing.
        display=f"{state} {live}{preferred}  {shown_name} {label}"
        rows.append((name,display,caps))
    return rows


def ollama_models(select_model=None):
    """Tiny Ollama control panel: select a model or toggle LOOK benchmark inclusion with X."""
    base=_ollama_base()
    if _ensure_ollama_server(base, allow_start=_is_local_ollama(base)) is None:
        print("LOOK OLLAMA · server unavailable")
        return 1

    try:
        installed=_ollama_tags(base)
        running=_ollama_ps(base)
    except Exception as exc:
        print(f"LOOK OLLAMA · {exc}")
        return 1

    names=[(m.get("name") or m.get("model") or "").strip() for m in installed]
    names=[n for n in names if n]
    resident={(m.get("name") or m.get("model") or "").strip() for m in running}
    resident.discard("")
    disabled=_load_ollama_model_prefs()

    if not names:
        print("LOOK OLLAMA · no installed models")
        return 1

    if select_model:
        if select_model not in names:
            print(f"LOOK OLLAMA · model not installed: {select_model}")
            return 1
        chosen=select_model
    elif sys.stdin.isatty() and sys.stdout.isatty() and shutil.which("fzf"):
        chosen=None
        while chosen is None:
            rows=_ollama_model_rows(base,names,resident,disabled)
            payload="\n".join(f"{name}\t{display}" for name,display,_ in rows)+"\n"
            result=subprocess.run(
                [
                    "fzf",
                    "--prompt","model › ",
                    "--header","Enter select · X enable/disable for LOOK test --all · ✓ enabled · × disabled · ● resident · ★ preferred",
                    "--height","~60%",
                    "--reverse",
                    "--no-multi",
                    "--delimiter","\t",
                    "--with-nth","2..",
                    "--ansi",
                    "--expect","x,X,enter",
                ],
                input=payload, text=True, capture_output=True
            )
            if result.returncode != 0 or not result.stdout.strip():
                return 0
            lines=result.stdout.rstrip("\r\n").splitlines()
            key=lines[0].lower() if lines else ""
            selected=lines[1] if len(lines)>1 else ""
            model=selected.split("\t",1)[0].strip()
            if not model:
                return 0
            if key=="x":
                if model in disabled:
                    disabled.remove(model)
                else:
                    disabled.add(model)
                _save_ollama_model_prefs(disabled)
                continue
            chosen=model
    else:
        rows=_ollama_model_rows(base,names,resident,disabled)
        _title("ollama models")
        print(f"  {_c('✓','32')} enabled · {_c('×','2')} disabled · {_c('●','32')} resident · {_c('★','33')} preferred")
        for _,display,_ in rows:
            print(f"  {display}")
        return 0

    try:
        with _activity(f"loading {chosen}"):
            _ollama_set_model(base, chosen)
    except Exception as exc:
        print(f"LOOK OLLAMA · could not load {chosen}: {exc}")
        return 1

    caps=_ollama_capabilities(base,chosen)
    suffix=f" · {_model_capability_label(caps)}"
    if chosen in disabled:
        suffix+=" · disabled from test --all"
    print(f"LOOK OLLAMA · {_c(chosen,'1;32')} selected{suffix}")
    return 0


def _benchmark_tool(name, description, properties, required):
    return {
        "type":"function",
        "function":{
            "name":name,
            "description":description,
            "parameters":{
                "type":"object",
                "properties":properties,
                "required":required,
            },
        },
    }


def _benchmark_chat(base, model, prompt, tools=None):
    payload={
        "model":model,
        "messages":[
            {"role":"system","content":"You are being tested for concise, reliable terminal-assistant behavior. Follow the request exactly."},
            {"role":"user","content":prompt},
        ],
        "stream":False,
        "keep_alive":"10m",
    }
    if tools:
        payload["tools"]=tools
    return _ollama_post(base, "/api/chat", payload, timeout=180)


def _benchmark_speed(base, model):
    """Measure first content arrival and Ollama's reported generation rate."""
    import json, urllib.request
    payload=json.dumps({
        "model":model,
        "messages":[{"role":"user","content":"Reply with exactly: LOOK-OK"}],
        "stream":True,
        "keep_alive":"10m",
    }).encode("utf-8")
    request=urllib.request.Request(
        base+"/api/chat", data=payload,
        headers={"Content-Type":"application/json"}, method="POST"
    )
    start=time.monotonic()
    first=None
    text=[]
    final={}
    with urllib.request.urlopen(request, timeout=180) as response:
        for raw in response:
            if not raw.strip():
                continue
            item=json.loads(raw)
            content=(item.get("message") or {}).get("content","")
            if content:
                if first is None:
                    first=time.monotonic()
                text.append(content)
            if item.get("done"):
                final=item
    elapsed=time.monotonic()-start
    ttft=(first-start) if first is not None else elapsed
    eval_count=int(final.get("eval_count") or 0)
    eval_duration=float(final.get("eval_duration") or 0)
    rate=(eval_count/(eval_duration/1e9)) if eval_count and eval_duration else 0.0
    exact="".join(text).strip()=="LOOK-OK"
    return ttft, rate, elapsed, exact


def _tool_call(result):
    calls=(result.get("message") or {}).get("tool_calls") or []
    if not calls:
        return "", {}
    fn=(calls[0] or {}).get("function") or {}
    return str(fn.get("name") or ""), fn.get("arguments") or {}


def _benchmark_one_model(base, model):
    """Small LOOK-specific test: responsiveness first, then tools only when supported."""
    results={"model":model}
    caps=_ollama_capabilities(base,model)
    results["caps"]=caps

    # Warm/load before timing so model-load time does not masquerade as token latency.
    _ollama_post(base, "/api/generate", {"model":model, "prompt":"", "keep_alive":"10m"}, timeout=180)

    # Speed/basic behavior is useful even when the model cannot call tools.
    try:
        ttft, rate, total, exact=_benchmark_speed(base, model)
        results.update(ttft=ttft, rate=rate, total=total, exact=exact)
    except Exception as exc:
        results["speed_error"]=str(exc)
        return results

    declared_tools=None if caps is None else ("tools" in caps)
    results["declared_tools"]=declared_tools

    # If Ollama explicitly says tools are unsupported, do not turn that into a benchmark crash.
    if declared_tools is False:
        results["tools"]=None
        return results

    read_tool=_benchmark_tool(
        "read_file","Read a bounded UTF-8 text file from the current workspace.",
        {"path":{"type":"string"}},["path"]
    )
    copy_tool=_benchmark_tool(
        "copy_path","Copy an existing file or directory exactly. Use this for copy, duplicate, clone, or backup requests.",
        {"source":{"type":"string"},"destination":{"type":"string"}},["source","destination"]
    )
    web_tool=_benchmark_tool(
        "web_search","Search the web for current or externally verifiable information.",
        {"query":{"type":"string"}},["query"]
    )

    checks=[]
    tool_errors=[]
    tests=[
        (
            "read",
            "Read README.txt before answering what this project is.",
            [read_tool],
            lambda name,args: name=="read_file" and str(args.get("path","")).endswith("README.txt"),
        ),
        (
            "copy",
            "Copy alpha.txt to alpha-copy.txt. Do not rewrite the file.",
            [copy_tool,read_tool],
            lambda name,args: (
                name=="copy_path"
                and str(args.get("source","")).endswith("alpha.txt")
                and str(args.get("destination","")).endswith("alpha-copy.txt")
            ),
        ),
        (
            "web",
            "What is the latest Ollama release? Use current information.",
            [web_tool],
            lambda name,args: name=="web_search" and bool(str(args.get("query","")).strip()),
        ),
    ]
    for label,prompt,tools,judge in tests:
        try:
            response=_benchmark_chat(base,model,prompt,tools)
            name,args=_tool_call(response)
            passed=bool(judge(name,args))
            results[label]=passed
            checks.append(passed)
        except Exception as exc:
            results[label]=False
            checks.append(False)
            tool_errors.append(f"{label}: {exc}")

    results["tools"]=sum(checks)
    if tool_errors:
        results["tool_error"]="; ".join(tool_errors)
    return results


def ollama_test(all_models=False):
    base=_ollama_base()
    running=_ensure_ollama_server(base, allow_start=_is_local_ollama(base))
    if running is None:
        print("LOOK OLLAMA · server unavailable")
        return 1

    disabled=_load_ollama_model_prefs()
    if all_models:
        try:
            installed=_ollama_tags(base)
        except Exception as exc:
            print(f"LOOK OLLAMA · {exc}")
            return 1
        models=[(m.get("name") or m.get("model") or "").strip() for m in installed]
        models=[m for m in models if m and m not in disabled]
    else:
        model,_=_choose_ollama_model(running)
        models=[model]

    if not models:
        if all_models and disabled:
            print("LOOK OLLAMA · no enabled models to test · use lk ollama models and X to enable one")
        else:
            print("LOOK OLLAMA · no models to test")
        return 1

    print("LOOK MODEL TEST")
    print("  warm-model TTFT · generation rate · exact response · LOOK tool judgment")
    if all_models and disabled:
        print(f"  enabled models only · {len(disabled)} disabled")
    print()

    rows=[]
    for model in models:
        print(f"  testing {model} ...", flush=True)
        try:
            row=_benchmark_one_model(base, model)
            rows.append(row)
        except Exception as exc:
            rows.append({"model":model,"fatal_error":str(exc)})
        if all_models:
            try:
                _ollama_post(base, "/api/generate", {"model":model, "keep_alive":0}, timeout=30)
            except Exception:
                pass

    print()
    print(f"{'MODEL':<28} {'TTFT':>7} {'TOK/S':>8} {'TOOLS':>9} {'EXACT':>7}  CAPABILITIES")
    print("-"*86)
    for row in rows:
        model=row["model"]
        if row.get("fatal_error"):
            print(f"{model:<28} {'—':>7} {'—':>8} {'error':>9} {'—':>7}  fatal")
            print(f"  error · {row['fatal_error']}")
            continue
        if row.get("speed_error"):
            caps=_model_capability_label(row.get("caps"))
            print(f"{model:<28} {'error':>7} {'—':>8} {'—':>9} {'—':>7}  {caps}")
            print(f"  speed error · {row['speed_error']}")
            continue

        tools=row.get("tools")
        if tools is None:
            tools_text="n/a"
        else:
            tools_text=f"{tools}/3"
        caps=_model_capability_label(row.get("caps"))
        print(
            f"{model:<28} "
            f"{row['ttft']:>6.2f}s "
            f"{row['rate']:>8.1f} "
            f"{tools_text:>9} "
            f"{('yes' if row['exact'] else 'no'):>7}  "
            f"{caps}"
        )
        if row.get("tool_error"):
            print(f"  tool note · {row['tool_error']}")

    good=[r for r in rows if "ttft" in r]
    tool_good=[r for r in good if isinstance(r.get("tools"),int)]
    if tool_good:
        winner=max(tool_good, key=lambda r:(r["tools"], bool(r["exact"]), -r["ttft"], r["rate"]))
        print(
            f"\n  LOOK fit   {winner['model']} · tools {winner['tools']}/3 · "
            f"{winner['ttft']:.2f}s TTFT · {winner['rate']:.1f} tok/s"
        )
    elif good:
        winner=max(good,key=lambda r:(bool(r["exact"]),-r["ttft"],r["rate"]))
        print(
            f"\n  chat fit   {winner['model']} · {winner['ttft']:.2f}s TTFT · "
            f"{winner['rate']:.1f} tok/s · tools unavailable"
        )

    # Restore the user's preferred model after a sweep.
    if all_models:
        preferred=_preferred_ollama_model()
        try:
            _ollama_set_model(base, preferred)
            print(f"  restored   {preferred}")
        except Exception:
            pass
    return 0



def _settings_share_state():
    tailscale=shutil.which("tailscale")
    if not tailscale:
        return "unavailable"
    try:
        proc=subprocess.run([tailscale,"serve","status"],capture_output=True,text=True,timeout=2)
        text=(proc.stdout or "")+(proc.stderr or "")
        if proc.returncode==0 and ("11435" in text or "11434" in text):
            return "on"
    except (OSError,subprocess.SubprocessError):
        pass
    return "off"


