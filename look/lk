    if args[0]=="sound":
        if len(args)==1:
            cfg["sound"]=not cfg["sound"]
        else:
            value=args[1].lower()
            if value not in {"on","off"}:
                print("usage: lk feedback sound on|off"); return 2
            cfg["sound"]=(value=="on")
        _save_feedback(cfg)
        print(f"LOOK sound · {'on' if cfg['sound'] else 'off'}")
        if cfg["sound"]:
            _feedback("accept","sound on")
        return 0
    if args[0]=="motion":
        if len(args)<2 or args[1].lower() not in {"off","subtle","normal"}:
            print("usage: lk feedback motion off|subtle|normal"); return 2
        cfg["motion"]=args[1].lower()
        _save_feedback(cfg)
        print(f"LOOK motion · {cfg['motion']}")
        _feedback("accept","motion")
        return 0
    if args[0]=="demo":
        for kind in ("accept","complete","notify","error"):
            _feedback(kind,kind)
            print(f"  {kind}")
        return 0
