def _append_learned_skill(skill):
    """Append one deduplicated learned skill; keep the section intentionally small."""
    skill=_sanitize_skill(skill)
    if not skill:
        return False
    _ensure_intelligence_files()
    current=_learned_skills()
    folded=skill.casefold()
    # Exact/near-contained duplicate prevention is sufficient at this scale.
    for old in current:
        oldf=old.casefold()
        if folded==oldf or folded in oldf or oldf in folded:
            return False
    if len(current)>=24:
        return False
    try:
        text=SKILLS_FILE.read_text(encoding="utf-8")
        marker="## Learned"
        if marker not in text:
            text=text.rstrip()+"\n\n## Learned\n\n"
        if not text.endswith("\n"):
            text+="\n"
        text+=f"- {skill}.\n"
        SKILLS_FILE.write_text(text,encoding="utf-8")
        return True
    except OSError:
        return False


def _learn_from_exchange(base, model, user_text, assistant_text, profile):
    """Self-learning respects LO's capability boundary."""
    if profile=="conservative":
        return False
    skill=_extract_skill_candidate(base,model,user_text,assistant_text)
    return bool(skill and _append_learned_skill(skill))



def _durable_memory_intent(user_text):
    low=" ".join(str(user_text or "").split()).casefold()
    phrases=(
        "remember it long term",
        "remember this long term",
        "remember that long term",
        "remember this permanently",
        "remember that permanently",
        "keep this in long-term memory",
        "keep that in long-term memory",
        "for long-term memory",
        "for memory and context",
        "memory and context sake",
    )
    return any(p in low for p in phrases)


def _memory_similarity_key(text):
    words=re.findall(r"[a-z0-9]+", str(text or "").casefold())
    stop={"the","a","an","to","be","is","are","for","and","of","in","on","user","context","memory","long","term"}
    return {w for w in words if w not in stop}


def _consolidate_memory_candidates(memory):
    """Merge only obvious duplicates; stronger wording survives."""
    items=sorted(memory.get("memories",[]), key=lambda m:int(m.get("importance",0)), reverse=True)
    kept=[]
    for item in items:
        text=str(item.get("text","")).strip()
        key=_memory_similarity_key(text)
        merged=False
        for old in kept:
            old_key=_memory_similarity_key(old.get("text",""))
            if not key or not old_key:
                continue
            intersection=key & old_key
            overlap=len(intersection)/max(1,min(len(key),len(old_key)))
            # Two distinctive shared tokens is enough for short candidate memories
            # such as "Portland OR context" vs "Portland OR location".
            obvious=(overlap >= 0.60 and len(intersection) >= 2)
            if obvious:
                old["importance"]=max(int(old.get("importance",0)),int(item.get("importance",0)))
                old["uses"]=max(int(old.get("uses",0)),int(item.get("uses",0)))
                old["created_at"]=min(float(old.get("created_at",time.time())),float(item.get("created_at",time.time())))
                old["last_reinforced"]=max(float(old.get("last_reinforced",0)),float(item.get("last_reinforced",0)))
                merged=True
                break
        if not merged:
            kept.append(item)
    memory["memories"]=kept[:MEMORY_CANDIDATE_LIMIT]
    return memory


def _rewrite_summary_maintenance(base, model, old_summary, memories, durable_text=""):
    strong=[m for m in memories if int(m.get("importance",0))>=60]
    material="\n".join(f"- [{int(m.get('importance',0))}] {m.get('text','')}" for m in strong[:14])
    prompt=f"""Rewrite the long-term user summary from scratch.

The summary is a compact current hypothesis about the user, not a permanent archive.
Keep only durable knowledge that would materially improve future conversations.

Preserve enduring preferences, current durable context, recurring projects/workflows,
and explicit long-term memory requests unless newer information contradicts them.

Remove or generalize stale implementation details, redundant facts, superseded facts,
and trivia whose removal would not materially hurt future conversations.

Hard maximum: 180 words.
Return ONLY the summary. No headings, analysis, exclusions, or word counts.

CURRENT SUMMARY:
{old_summary or "(empty)"}

STRONG CANDIDATES:
{material or "(none)"}

EXPLICIT DURABLE MEMORY:
{durable_text or "(none)"}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"Maintain a compact, current, forgetful long-term user summary. Output only the summary."},
            {"role":"user","content":prompt},
        ], num_ctx=4096, num_predict=300, think=False, temperature=0.15)
        clean=_sanitize_summary(raw)
        return clean if clean else old_summary
    except Exception:
        return old_summary


def _remember_exchange(base, model, memory, user_text, assistant_text, profile="workspace"):
    memory=_decay_memories(memory)

    candidate=_extract_memory_candidate(base,model,user_text,assistant_text)
    if not candidate:
        candidate=_explicit_memory_hint(user_text)

    durable=_durable_memory_intent(user_text)
    durable_text=""

    if candidate:
        importance,text=candidate
        if durable:
            importance=max(importance,90)
            durable_text=text
        memory=_add_memory(memory,text,importance)

    memory=_consolidate_memory_candidates(memory)

    cycles=int(memory.get("maintenance_cycles",0))+1
    memory["maintenance_cycles"]=cycles
    if durable and durable_text:
        memory["summary"]=_rewrite_summary_maintenance(
            base,model,str(memory.get("summary","")),memory.get("memories",[]),durable_text
        )
    elif cycles % 6 == 0:
        memory["summary"]=_rewrite_summary(
            base,model,str(memory.get("summary","")),memory.get("memories",[])
        )
    if cycles % 18 == 0 or len(str(memory.get("summary","")).split()) > 180:
        memory["summary"]=_rewrite_summary_maintenance(
            base,model,str(memory.get("summary","")),memory.get("memories",[])
        )

    _save_memory(memory)
    _learn_from_exchange(base,model,user_text,assistant_text,profile)
    return memory


def _memory_job_files():
    try:
        return sorted(MEMORY_QUEUE.glob("*.json"))
    except OSError:
        return []


def _memory_worker_active():
    try:
        pid=int(MEMORY_WORKER_LOCK.read_text().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        try:
            MEMORY_WORKER_LOCK.unlink()
        except OSError:
            pass
        return False


def _start_memory_worker():
    """Start one detached memory worker; duplicate launches exit harmlessly."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_remember-worker"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError:
        pass


def _queue_memory_exchange(base, model, user_text, assistant_text, profile="workspace"):
    """Durably enqueue an exchange, then let detached housekeeping own compression."""
    try:
        MEMORY_QUEUE.mkdir(parents=True, exist_ok=True)
        token=f"{time.time_ns()}-{uuid.uuid4().hex[:8]}"
        tmp=MEMORY_QUEUE/(token+".tmp")
        job=MEMORY_QUEUE/(token+".json")
        payload={
            "base":base,
            "model":model,
            "user":user_text[:12000],
            "assistant":assistant_text[:16000],
            "profile":profile if profile in LO_PROFILES else "workspace",
        }
        tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(job)
        os.chmod(job, 0o600)
        _start_memory_worker()
        return True
    except OSError:
        return False


def _memory_worker():
    """Drain queued memory jobs serially, then exit. Safe across lo sessions."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    # Atomic lock creation gives us one worker without a daemon or dependency.
    try:
        fd=os.open(MEMORY_WORKER_LOCK, os.O_CREAT|os.O_EXCL|os.O_WRONLY, 0o600)
    except FileExistsError:
        return 0
    try:
        os.write(fd, str(os.getpid()).encode())
    finally:
        os.close(fd)

    try:
        while True:
            jobs=_memory_job_files()
            if not jobs:
                break

            job_path=jobs[0]
            try:
                job=json.loads(job_path.read_text(encoding="utf-8"))
                memory=_load_memory()
                _remember_exchange(
                    job.get("base","http://127.0.0.1:11434"),
                    job.get("model",os.environ.get("LOOK_OLLAMA_MODEL","qwen3:8b")),
                    memory,
                    str(job.get("user","")),
                    str(job.get("assistant","")),
                    str(job.get("profile","workspace")),
                )
                job_path.unlink()
            except Exception:
                # Leave the job for a future worker rather than losing memory.
                break
    finally:
        try:
            MEMORY_WORKER_LOCK.unlink()
        except OSError:
            pass

    # Close the tiny shutdown race: if a job arrived while we released the lock,
    # launch one fresh worker to pick it up.
    if _memory_job_files():
        _start_memory_worker()
    return 0



def _safe_workspace_path(workspace, raw_path="."):
    """Resolve a path while keeping Ollama file tools inside the starting cwd."""
    workspace = Path(workspace).resolve()
    raw_path = raw_path or "."
    candidate = Path(raw_path).expanduser()
    if not candidate.is_absolute():
        candidate = workspace / candidate
    candidate = candidate.resolve()
    try:
        candidate.relative_to(workspace)
    except ValueError:
        raise ValueError("path is outside the LOOK Ollama workspace")
    return candidate


def _workspace_snapshot(workspace):
    """Small guaranteed folder context; deeper inspection is handled by tools."""
    workspace = Path(workspace).resolve()
    try:
        entries = sorted(workspace.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))[:120]
    except OSError as exc:
        return f"Current workspace: {workspace}\nDirectory listing unavailable: {exc}"
    shown=[]
    for item in entries:
        try:
            suffix="/" if item.is_dir() else ""
        except OSError:
            suffix=""
        shown.append(item.name + suffix)
    more="\n…listing truncated" if len(entries) == 120 else ""
    return (
        f"Current workspace: {workspace}\n"
        "Treat this as the user's current folder. File tools are restricted to this folder and its descendants.\n"
        "Top-level contents:\n" + ("\n".join(shown) if shown else "(empty)") + more
    )


def _tool_list_files(workspace, path=".", depth=1):
    target=_safe_workspace_path(workspace, path)
    if not target.exists():
        return f"Not found: {path}"
    if not target.is_dir():
        return f"Not a directory: {path}"
    depth=max(1, min(int(depth or 1), 3))
    lines=[]
    def walk(folder, level):
        if level > depth or len(lines) >= 250:
            return
        try:
            children=sorted(folder.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
        except (OSError, PermissionError):
            return
        for child in children:
            if len(lines) >= 250:
                return
            rel=child.relative_to(workspace)
            try:
                is_dir=child.is_dir()
            except OSError:
                is_dir=False
            lines.append(str(rel) + ("/" if is_dir else ""))
            if is_dir:
                walk(child, level+1)
    walk(target, 1)
    return "\n".join(lines) if lines else "(empty or unreadable)"


def _tool_read_file(workspace, path):
    target=_safe_workspace_path(workspace, path)
    if not target.exists():
        return f"Not found: {path}"
    if not target.is_file():
        return f"Not a file: {path}"

    # PDF is a container format, not text. Extract deterministically at the
    # edge and give the model only readable text.
    if target.suffix.lower()==".pdf":
        pdftotext=shutil.which("pdftotext")
        if not pdftotext:
            return "PDF text extraction unavailable; install pdftotext (Poppler)."
        try:
            result=subprocess.run(
                [pdftotext,"-layout",str(target),"-"],
                capture_output=True,text=True,timeout=8
            )
            if result.returncode!=0:
                detail=result.stderr.strip()
                return "PDF text extraction failed." + (f" {detail[:300]}" if detail else "")
            text=result.stdout.strip()
            if not text:
                return "PDF contains no extractable text; it may be scanned/image-only."
            return text[:16000] + ("\n…truncated" if len(text) > 16000 else "")
        except (OSError,subprocess.SubprocessError) as exc:
            return f"PDF text extraction failed: {exc}"

    try:
        if target.stat().st_size > 1_000_000:
            return "File is larger than the 1 MB read limit."
        data=target.read_bytes()
        if b"\x00" in data[:4096]:
            return "Binary file; text extraction unavailable for this format."
        text=data.decode("utf-8", errors="replace")
        return text[:16000] + ("\n…truncated" if len(text) > 16000 else "")
    except OSError as exc:
        return f"Read failed: {exc}"


def _tool_search_files(workspace, query, path="."):
    target=_safe_workspace_path(workspace, path)
    if not target.exists() or not target.is_dir():
        return f"Not a directory: {path}"
    needle=(query or "").lower()
    if not needle:
        return "Search query is empty."
    matches=[]
    scanned=0
    for root, dirs, files in os.walk(target):
        rootp=Path(root)
        try:
            rel_depth=len(rootp.relative_to(target).parts)
        except ValueError:
            continue
        dirs[:] = [d for d in dirs if not d.startswith('.') and rel_depth < 4]
        for name in dirs + files:
            rel=(rootp / name).relative_to(workspace)
            if needle in name.lower():
                matches.append(str(rel) + ("/" if name in dirs else ""))
                if len(matches) >= 100:
                    return "\n".join(matches)
        for name in files:
            if scanned >= 500 or len(matches) >= 100:
                break
            scanned += 1
            filep=rootp / name
            try:
                if filep.stat().st_size > 300_000:
                    continue
                data=filep.read_bytes()
                if b"\x00" in data[:4096]:
                    continue
                text=data.decode("utf-8", errors="ignore")
            except OSError:
                continue
            if needle in text.lower():
                rel=filep.relative_to(workspace)
                if str(rel) not in matches:
                    matches.append(str(rel))
        if scanned >= 500 or len(matches) >= 100:
            break
    return "\n".join(matches) if matches else "No matches."


def _tool_write_file(workspace, path, content, overwrite=False):
    target=_safe_workspace_path(workspace, path)
    if target.exists() and not overwrite:
        return f"Refusing to overwrite existing file: {path}. Set overwrite=true only when the user explicitly asked to replace it."
    if not target.parent.exists() or not target.parent.is_dir():
        return f"Parent directory does not exist: {target.parent.relative_to(Path(workspace).resolve())}"
    try:
        target.write_text(content, encoding="utf-8")
        return f"Wrote {len(content.encode('utf-8'))} bytes to {target.relative_to(Path(workspace).resolve())}"
    except OSError as exc:
        return f"Write failed: {exc}"



def _tool_create_text_files(workspace, files):
    """Create several new text files atomically enough for chat use, with one undo record."""
    if not isinstance(files,list) or not files:
        return "Batch create refused: files must be a non-empty list."
    if len(files)>32:
        return "Batch create refused: maximum 32 files."

    root=Path(workspace).resolve()
    planned=[]
    seen=set()
    total_bytes=0
    for item in files:
        if not isinstance(item,dict):
            return "Batch create refused: every item needs path and content."
        raw=str(item.get("path","")).strip()
        content=str(item.get("content",""))
        if not raw:
            return "Batch create refused: empty path."
        target=_safe_workspace_path(workspace,raw)
        key=str(target)
        if key in seen:
            return f"Batch create refused: duplicate path: {raw}"
        seen.add(key)
        if target.exists():
            return f"Batch create refused: path already exists: {raw}"
        if not target.parent.exists() or not target.parent.is_dir():
            return f"Batch create refused: parent directory does not exist: {target.parent.relative_to(root)}"
        size=len(content.encode("utf-8"))
        total_bytes+=size
        if total_bytes>2_000_000:
            return "Batch create refused: combined text exceeds 2 MB."
        planned.append((target,content))

    created=[]
    try:
        for target,content in planned:
            target.write_text(content,encoding="utf-8")
            created.append({
                "kind":"create_text",
                "path":str(target),
                "sha256":_sha256_file(target),
            })
        _record_undo({"kind":"batch","items":created,"time":time.time()})
        names=", ".join(Path(x["path"]).name for x in created[:6])
        more=f" +{len(created)-6} more" if len(created)>6 else ""
        return f"CREATE FILES OK · {len(created)} files · {names}{more} · undo available · lk undo"
    except OSError as exc:
        for item in reversed(created):
            try:
                p=Path(item["path"])
                if p.exists() and p.is_file() and _sha256_file(p)==item["sha256"]:
                    p.unlink()
            except OSError:
                pass
        return f"Batch create failed: {exc}"



def _sha256_file(path):
    digest=hashlib.sha256()
    with Path(path).open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024*1024), b""):
            digest.update(chunk)
    return digest.hexdigest()



def _load_undo():
    try:
        data=json.loads(UNDO_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, list) else []
    except (OSError, ValueError, json.JSONDecodeError):
        return []


def _save_undo(entries, trim=True):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    stored=entries[-UNDO_LIMIT:] if trim else entries
    UNDO_FILE.write_text(json.dumps(stored, indent=2), encoding="utf-8")
    try: os.chmod(UNDO_FILE, 0o600)
    except OSError: pass


def _record_undo(entry, batch_id=None):
    entry=dict(entry)
    if batch_id:
        entry["_batch_id"]=batch_id
    entries=_load_undo()
    entries.append(entry)

    # During a batch, keep every temporary transaction record even if the
    # normal undo ring is already full. `_batch_action` collapses them to one
    # public record and restores the normal cap at commit/rollback.
    if batch_id:
        _save_undo(entries, trim=False)
        return

    dropped=entries[:-UNDO_LIMIT]
    entries=entries[-UNDO_LIMIT:]
    _save_undo(entries)
    for old in dropped:
        trash=old.get("trash")
        if trash:
            try:
                p=Path(trash)
                if p.is_dir(): shutil.rmtree(p)
                elif p.exists(): p.unlink()
            except OSError:
                pass


def _undo_last():
    entries=_load_undo()
    if not entries:
        print("LOOK undo · nothing to undo")
        return 1
    entry=entries[-1]
    kind=entry.get("kind")
    try:
        if kind=="copy":
            dst=Path(entry["destination"])
            if not dst.exists():
                raise RuntimeError("copied destination no longer exists")
            expected=entry.get("sha256")
            if expected and dst.is_file() and _sha256_file(dst) != expected:
                raise RuntimeError("copied file has changed; refusing to remove it")
            if dst.is_dir(): shutil.rmtree(dst)
            else: dst.unlink()
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"removed copied {dst.name}"
        elif kind=="move":
            src=Path(entry["source"]); dst=Path(entry["destination"])
            if not dst.exists():
                raise RuntimeError("moved path no longer exists")
            if src.exists():
                raise RuntimeError("original location is occupied")
            shutil.move(str(dst), str(src))
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"{dst.name} → {src}"
        elif kind=="remove":
            original=Path(entry["source"]); trash=Path(entry["trash"])
            if original.exists():
                raise RuntimeError("original location is occupied")
            if not trash.exists():
                raise RuntimeError("recoverable item is no longer available")
            original.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(trash), str(original))
            detail=f"{original.name} restored"
        elif kind=="mkdir":
            path=Path(entry["path"])
            if not path.exists():
                raise RuntimeError("directory no longer exists")
            if not path.is_dir() or any(path.iterdir()):
                raise RuntimeError("directory is no longer empty; refusing to remove it")
            path.rmdir()
            _cleanup_created_dirs([p for p in entry.get("created_dirs",[]) if Path(p)!=path])
            detail=f"removed empty {path.name}/"
        elif kind=="touch":
            path=Path(entry["path"])
            if not path.exists():
                raise RuntimeError("created file no longer exists")
            if not path.is_file():
                raise RuntimeError("created path is no longer a regular file")
            stat=path.stat()
            if stat.st_size!=0:
                raise RuntimeError("created file now contains data; refusing to remove it")
            expected=entry.get("mtime_ns")
            if expected is not None and stat.st_mtime_ns!=expected:
                raise RuntimeError("created file has changed; refusing to remove it")
            path.unlink()
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"removed empty {path.name}"
        elif kind=="batch":
            items=entry.get("items",[])
            for item in reversed(items):
                ik=item.get("kind")
                if ik=="copy":
                    dst=Path(item["destination"])
                    if not dst.exists(): raise RuntimeError(f"{dst.name} no longer exists")
                    expected=item.get("sha256")
                    if expected and dst.is_file() and _sha256_file(dst)!=expected:
                        raise RuntimeError(f"{dst.name} changed; refusing batch undo")
                    if dst.is_dir(): shutil.rmtree(dst)
                    else: dst.unlink()
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="move":
                    src=Path(item["source"]); dst=Path(item["destination"])
                    if not dst.exists(): raise RuntimeError(f"{dst.name} no longer exists")
                    if src.exists(): raise RuntimeError(f"{src} is occupied")
                    shutil.move(str(dst),str(src))
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="remove":
                    original=Path(item["source"]); trash=Path(item["trash"])
                    if original.exists(): raise RuntimeError(f"{original} is occupied")
                    if not trash.exists(): raise RuntimeError(f"{original.name} is no longer recoverable")
                    original.parent.mkdir(parents=True,exist_ok=True)
                    shutil.move(str(trash),str(original))
                elif ik=="create_text":
                    path=Path(item["path"])
                    if not path.exists() or not path.is_file():
                        raise RuntimeError(f"{path.name} no longer exists")
                    expected=item.get("sha256")
                    if expected and _sha256_file(path)!=expected:
                        raise RuntimeError(f"{path.name} changed; refusing batch undo")
                    path.unlink()
            detail=f"{len(items)} items restored"
        else:
            raise RuntimeError("unknown undo record")
    except (OSError, RuntimeError) as exc:
        print(f"{_c('✗','31')} LOOK undo · refused · {exc}")
        return 1
    entries.pop()
    _save_undo(entries)
    print(f"{_c('↶ UNDO','1;32')} · {kind}")
    print(f"  {detail}")
    return 0





def _batch_action(kind, destination, paths):
    """Perform several LOOK mutations as one transaction, independent of undo-ring fullness."""
    if not paths:
        print(f"{_c('✗','31')} {kind.upper()} failed · no source paths")
        return 1

    txid=uuid.uuid4().hex
    results=[]
    failed_source=None
    try:
        if kind in {"copy","move"}:
            if len(paths)>1:
                raw=str(destination)
                if not raw.endswith(("/",os.sep)):
                    raw+=os.sep
                destination=raw

            for index,raw in enumerate(paths,1):
                failed_source=str(raw)
                result=_interactive_file_action(kind,raw,destination,batch_id=txid)
                if not result.startswith(("COPY OK","MOVE OK")):
                    raise RuntimeError(result)
                results.append(result)

        elif kind=="remove":
            for index,raw in enumerate(paths,1):
                failed_source=str(raw)
                result=_journal_remove(raw,batch_id=txid)
                if not result.startswith("REMOVE OK"):
                    raise RuntimeError(result)
                results.append(result)
        else:
            raise RuntimeError("unknown batch action")

        # Extract our records by transaction id, not journal length. This still
        # works when the bounded undo ring was already full before the batch.
        journal=_load_undo()
        created=[entry for entry in journal if entry.get("_batch_id")==txid]
        if len(created)!=len(paths):
            raise RuntimeError(
                f"transaction record mismatch · expected {len(paths)} items, recorded {len(created)}"
            )

        # Remove temporary transaction tags before exposing the public undo record.
        clean=[]
        for entry in created:
            item=dict(entry)
            item.pop("_batch_id",None)
            clean.append(item)

        survivors=[entry for entry in journal if entry.get("_batch_id")!=txid]
        survivors.append({
            "kind":"batch",
            "items":clean,
            "time":time.time(),
            "action":kind,
        })
        _save_undo(survivors[-UNDO_LIMIT:])

        _feedback("complete",f"{kind} complete")
        print(f"{kind.upper()} OK · {len(paths)} item{'s' if len(paths)!=1 else ''} · undo available · lk undo")
        receipt_limit=12
        for raw,result in list(zip(paths,results))[:receipt_limit]:
            # Compact receipt: show exactly what succeeded without repeating hashes.
            detail=result.split(" · undo available",1)[0]
            print(f"  ✓ {detail}")
        if len(results)>receipt_limit:
            print(f"  … {len(results)-receipt_limit} more succeeded")
        return 0

    except RuntimeError as exc:
        # Roll back only entries tagged with this transaction. We cannot use
        # `_undo_last()` here because unrelated older records may surround a
        # capped journal and the batch must remain self-contained.
        journal=_load_undo()
        created=[entry for entry in journal if entry.get("_batch_id")==txid]
        rollback_errors=[]
        rolled_back=0

        for item in reversed(created):
            try:
                ik=item.get("kind")
                if ik=="copy":
                    dst=Path(item["destination"])
                    if dst.exists():
                        expected=item.get("sha256")
                        if expected and dst.is_file() and _sha256_file(dst)!=expected:
                            raise RuntimeError(f"{dst.name} changed")
                        if dst.is_dir(): shutil.rmtree(dst)
                        else: dst.unlink()
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="move":
                    src=Path(item["source"]); dst=Path(item["destination"])
                    if dst.exists():
                        if src.exists():
                            raise RuntimeError(f"{src} is occupied")
                        shutil.move(str(dst),str(src))
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="remove":
                    original=Path(item["source"]); trash=Path(item["trash"])
                    if trash.exists():
                        if original.exists():
                            raise RuntimeError(f"{original} is occupied")
                        original.parent.mkdir(parents=True,exist_ok=True)
                        shutil.move(str(trash),str(original))
                rolled_back+=1
            except (OSError,RuntimeError) as rollback_exc:
                rollback_errors.append(str(rollback_exc))

        survivors=[entry for entry in journal if entry.get("_batch_id")!=txid]
        _save_undo(survivors)

        _feedback("error",f"{kind} failed")
        print(f"{_c('✗','31')} {kind.upper()} failed")
        if failed_source:
            print(f"  at       {failed_source}")
        print(f"  reason   {exc}")
        if created:
            if rollback_errors:
                print(f"  rollback {rolled_back}/{len(created)} restored")
                for error in rollback_errors[:4]:
                    print(f"           {_c('!','33')} {error}")
            else:
                print(f"  rollback {rolled_back}/{len(created)} restored · no partial {kind} remains")
        return 1


def _interactive_file_action(kind, src, dest, batch_id=None):
    action=_journal_copy if kind=="copy" else _journal_move
    result=action(src,dest,batch_id=batch_id)
    if result.startswith("CREATE_DIR_REQUIRED · "):
        needed=result.split(" · ",1)[1]
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return result
        try:
            answer,cancelled=_prompt_line(
                f"{needed} does not exist\nM create directory and continue · Esc/Enter cancel › "
            )
        except KeyboardInterrupt:
            return "· cancelled"
        if cancelled or answer.strip().lower()!="m":
            return "· cancelled"
        result=action(src,dest,create_missing=True,batch_id=batch_id)
    return result


def _prompt_line(prompt):
    """Read one short action value; bare Esc cancels without Ctrl-C."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        try:
            return input(prompt),False
        except (EOFError,KeyboardInterrupt):
            return '',True
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    chars=[]
    try:
        tty.setcbreak(fd)
        sys.stdout.write(prompt); sys.stdout.flush()
        while True:
            ch=os.read(fd,1)
            if ch==b'\x1b':
                sys.stdout.write('\n'); sys.stdout.flush()
                return '',True
            if ch in {b'\r',b'\n'}:
                sys.stdout.write('\n'); sys.stdout.flush()
                return ''.join(chars),False
            if ch in {b'\x7f',b'\b'}:
                if chars:
                    chars.pop()
                    sys.stdout.write('\b \b'); sys.stdout.flush()
                continue
            if ch==b'\x03':
                raise KeyboardInterrupt
            text=ch.decode('utf-8','ignore')
            if text and text.isprintable():
                chars.append(text)
                sys.stdout.write(text); sys.stdout.flush()
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)


def _action_result(text):
    """Color only the CLI presentation; tool/API text stays plain."""
    if not sys.stdout.isatty():
        return text
    success_prefixes=("COPY OK","MOVE OK","REMOVE OK","MKDIR OK","FILE OK")
    if text.startswith(success_prefixes):
        head, sep, tail=text.partition(" · ")
        return f"{_c('✓','32')} {_c(head,'1;32')}{sep}{tail}"
    if any(word in text.lower() for word in ("failed","refused","mismatch")):
        return f"{_c('✗','31')} {text}"
    return text


def _destination_plan(src, requested):
    raw=str(requested)
    req=Path(requested).expanduser().resolve()
    directory_intent=raw.endswith(("/", os.sep)) or (req.exists() and req.is_dir())
    dst=req/src.name if directory_intent else req
    needed_root=req if directory_intent else dst.parent
    return req,dst,directory_intent,needed_root


def _copy_variant(path):
    path=Path(path)
    if path.is_dir() or not path.suffix:
        base=path.name
        suffix=""
    else:
        base=path.stem
        suffix=path.suffix
    parent=path.parent
    candidate=parent/f"{base} copy{suffix}"
    number=2
    while candidate.exists():
        candidate=parent/f"{base} copy {number}{suffix}"
        number+=1
    return candidate


def _missing_directories(path):
    path=Path(path)
    missing=[]
    cursor=path
    while not cursor.exists():
        missing.append(cursor)
        parent=cursor.parent
        if parent==cursor:
            break
        cursor=parent
    return list(reversed(missing))


def _make_missing_directories(path):
    created=[]
    for folder in _missing_directories(path):
        folder.mkdir()
        created.append(str(folder))
    return created


def _cleanup_created_dirs(paths):
    for raw in reversed(paths or []):
        p=Path(raw)
        try:
            if p.is_dir() and not any(p.iterdir()):
                p.rmdir()
        except OSError:
            pass


def _journal_copy(src, requested_destination, create_missing=False, batch_id=None):
    src=Path(src).expanduser().resolve()
    req,dst,directory_intent,needed_root=_destination_plan(src, requested_destination)
    if not src.exists():
        return f"Copy failed: source not found: {src}"
    if dst==src and req.exists() and req.is_dir():
        dst=_copy_variant(src)
        needed_root=dst.parent
    elif dst.exists():
        return f"Copy refused: destination already exists: {dst}"
    missing=_missing_directories(needed_root)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {needed_root}"
    created=[]
    try:
        if missing:
            created=_make_missing_directories(needed_root)
        if src.is_dir():
            shutil.copytree(src,dst,copy_function=shutil.copy2)
            files=sum(1 for p in dst.rglob("*") if p.is_file())
            _record_undo({"kind":"copy","destination":str(dst),"created_dirs":created,"time":time.time()}, batch_id=batch_id)
            return f"COPY OK · {src.name} → {dst} · directory · {files} files · undo available · lk undo"
        shutil.copy2(src,dst)
        source_hash=_sha256_file(src); destination_hash=_sha256_file(dst)
        if source_hash != destination_hash:
            try: dst.unlink()
            except OSError: pass
            _cleanup_created_dirs(created)
            return "Copy verification failed: SHA-256 mismatch; destination was removed."
        _record_undo({"kind":"copy","destination":str(dst),"sha256":destination_hash,"created_dirs":created,"time":time.time()}, batch_id=batch_id)
        return f"COPY OK · {src.name} → {dst} · {src.stat().st_size} bytes · SHA-256 verified identical · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Copy failed: {exc}"


def _journal_move(src, requested_destination, create_missing=False, batch_id=None):
    src=Path(src).expanduser().resolve()
    req,dst,directory_intent,needed_root=_destination_plan(src, requested_destination)
    if not src.exists():
        return f"Move failed: source not found: {src}"
    if dst.exists():
        return f"Move refused: destination already exists: {dst}"
    missing=_missing_directories(needed_root)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {needed_root}"
    created=[]
    try:
        if missing:
            created=_make_missing_directories(needed_root)
        shutil.move(str(src),str(dst))
        _record_undo({"kind":"move","source":str(src),"destination":str(dst),"created_dirs":created,"time":time.time()}, batch_id=batch_id)
        return f"MOVE OK · {src.name} → {dst} · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Move failed: {exc}"



def _journal_remove(path, batch_id=None):
    target=Path(path).expanduser().resolve()
    if not target.exists():
        return f"Remove failed: not found: {target}"
    if target == Path(target.anchor):
        return "Remove refused: filesystem root cannot be removed."
    try:
        UNDO_TRASH.mkdir(parents=True,exist_ok=True)
        token=f"{int(time.time()*1000)}-{uuid.uuid4().hex[:8]}"
        stash=UNDO_TRASH/token
        shutil.move(str(target),str(stash))
        _record_undo({"kind":"remove","source":str(target),"trash":str(stash),"time":time.time()}, batch_id=batch_id)
        return f"REMOVE OK · {target.name} · recoverable · undo available · lk undo"
    except OSError as exc:
        return f"Remove failed: {exc}"


def _journal_mkdir(path):
    target=Path(path).expanduser().resolve()
    if target.exists():
        return f"Directory already exists: {target}" if target.is_dir() else f"Create directory failed: path exists as a file: {target}"
    missing=_missing_directories(target)
    try:
        target.mkdir(parents=True)
        created=[str(p) for p in missing]
        _record_undo({"kind":"mkdir","path":str(target),"created_dirs":created,"time":time.time()})
        return f"MKDIR OK · {target} · undo available · lk undo"
    except OSError as exc:
        return f"Create directory failed: {exc}"


def _journal_touch(path, create_missing=False):
    target=Path(path).expanduser().resolve()
    if target.exists():
        return f"Create file refused: path already exists: {target}"

    parent=target.parent
    missing=_missing_directories(parent)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {parent}"

    created=[]
    try:
        if missing:
            created=_make_missing_directories(parent)
        target.touch(exist_ok=False)
        stat=target.stat()
        _record_undo({
            "kind":"touch",
            "path":str(target),
            "created_dirs":created,
            "mtime_ns":stat.st_mtime_ns,
            "time":time.time(),
        })
        return f"FILE OK · {target} · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Create file failed: {exc}"



def _tool_copy_path(workspace, source, destination):
    src=_safe_workspace_path(workspace,source)
    raw=Path(destination).expanduser()
    requested=raw if raw.is_absolute() else Path(workspace).resolve()/raw
    dst=_safe_workspace_path(workspace,str(requested))
    # Existing directory destination is allowed, but the resulting child must also remain inside workspace.
    final=_final_destination(src,dst)
    _safe_workspace_path(workspace,str(final))
    return _journal_copy(src,dst)


def _tool_move_path(workspace, source, destination):
    src=_safe_workspace_path(workspace,source)
    raw=Path(destination).expanduser()
    requested=raw if raw.is_absolute() else Path(workspace).resolve()/raw
    dst=_safe_workspace_path(workspace,str(requested))
    final=_final_destination(src,dst)
    _safe_workspace_path(workspace,str(final))
    return _journal_move(src,dst)


def _tool_remove_path(workspace, path, confirmed=False):
    target=_safe_workspace_path(workspace,path)
    if not confirmed:
        return "Remove refused: confirmed=true is required, and may be used only when the user explicitly asked to remove this path."
    if target == Path(workspace).resolve():
        return "Remove refused: the LOOK workspace root cannot be removed."
    return _journal_remove(target)


def _tool_make_directory(workspace, path):
    target=_safe_workspace_path(workspace,path)
    return _journal_mkdir(target)



LO_PROFILES=("conservative","workspace","power","unsafe")


LO_PERSONALITIES=("lo","robot","max","philosopher")
LO_THINKING=("light","adaptive","deep")
LO_THINK_DISPLAY=("compact","full","quiet")

# LO keeps a bounded working set. Persistent continuity belongs to memory, not an
# ever-growing chat transcript. Output ceilings are intentionally generous: they
# are limits, not targets, and modern local hardware benefits more from headroom
# than from prematurely truncating useful work.
LO_CONTEXT_TOKENS=8192
LO_LIGHT_OUTPUT_TOKENS=800
LO_ADAPTIVE_OUTPUT_TOKENS=1400
LO_DEEP_OUTPUT_TOKENS=2000
LO_HISTORY_MAX_MESSAGES=20
LO_HISTORY_MAX_CHARS=14000

def _lo_prompt_needs_thinking(prompt):
    """Small, inspectable adaptive heuristic; avoid turning casual chat into a reasoning job."""
    text=" ".join(str(prompt or "").split()).casefold()
    if len(text) >= 260 or "```" in text or "traceback" in text:
        return True
    structural=(
        "debug", "diagnose", "analy", "compare", "tradeoff", "trade-off",
        "architect", "design", "refactor", "implement", "why does", "why is",
        "step by step", "plan", "reason", "prove", "review this code",
    )
    return sum(1 for marker in structural if marker in text) >= 1

_LO_MUTATION_TOOLS={"write_file","create_text_files","copy_path","move_path","remove_path","make_directory"}

def _lo_requires_filesystem_action(prompt):
    """Conservative host-side detector for explicit local mutation requests."""
    text=" ".join(str(prompt or "").split()).casefold()
    action=(
        r"\b(create|make|write|save|copy|duplicate|move|rename|remove|delete|edit|replace)\b"
    )
    object_hint=(
        r"\b(file|files|folder|folders|directory|directories|path|paths|txt|md|json|csv|yaml|yml|py|js|html)\b"
        r"|[./~][^\s]*"
    )
    # Exclude obvious explanatory questions.
    if re.search(r"\b(how (do|would|can)|what command|explain|show me how)\b",text):
        return False
    return bool(re.search(action,text) and re.search(object_hint,text))

def _lo_runtime_policy(mode, prompt):
    mode=(mode or "adaptive").lower()
    if mode=="light":
        return {"think":False,"num_predict":LO_LIGHT_OUTPUT_TOKENS,"temperature":0.35}
    if mode=="deep":
        return {"think":True,"num_predict":LO_DEEP_OUTPUT_TOKENS,"temperature":0.30}
    return {
        "think":_lo_prompt_needs_thinking(prompt),
        "num_predict":LO_ADAPTIVE_OUTPUT_TOKENS,
        "temperature":0.35,
    }

def _lo_message_size(message):
    try:
        return len(json.dumps(message, ensure_ascii=False, default=str))
    except Exception:
        return len(str(message))

def _trim_lo_history(messages, base_count):
    """Keep core system context plus a bounded recent working conversation."""
    base=list(messages[:base_count])
    tail=list(messages[base_count:])[-LO_HISTORY_MAX_MESSAGES:]
    kept=[]
    used=0
    for item in reversed(tail):
        size=_lo_message_size(item)
        if kept and used+size > LO_HISTORY_MAX_CHARS:
            break
        kept.append(item); used+=size
    kept.reverse()
    # Never begin retained history in the middle of a tool-call transaction.
    while kept and kept[0].get("role") != "user":
        kept.pop(0)
    return base+kept

def _read_choice(path, allowed, default, env_name=None):
