    elif not manifest:
        print()
        print("No install ownership manifest exists (this LOOK predates tracking).")
        print("Packages and shell add-ons will be left untouched.")

    # Preserve the current LOOK-era zshrc before restoring anything. This makes
    # post-install user edits recoverable even when the original backup is restored.
    current_zsh=HOME/".zshrc"
    if current_zsh.exists():
        stamp=time.strftime("%Y%m%d-%H%M%S")
        preserved=HOME/f".zshrc.look-uninstalled.{stamp}"
        try:
            shutil.copy2(current_zsh,preserved)
            print(f"preserved current ~/.zshrc → {preserved}")
        except OSError as e:
            print(f"LOOK: could not preserve current ~/.zshrc: {e}")
            return 1

    look_hook_start="# >>> LOOK Shell >>>"
    look_hook_end="# <<< LOOK Shell <<<"
    look_fragment=HOME/".config/look/look.zsh"

    modern_hook=False
    if current_zsh.exists():
        try:
            text=current_zsh.read_text()
            if look_hook_start in text:
                modern_hook=True
                while look_hook_start in text:
                    a=text.find(look_hook_start)
                    b=text.find(look_hook_end,a)
                    if b<0:
                        text=text[:a].rstrip()+"\n"
                        break
                    b+=len(look_hook_end)
                    left=text[:a].rstrip()
                    right=text[b:].lstrip("\n")
                    text=(left+"\n\n" if left else "")+right
                current_zsh.write_text(text.rstrip()+"\n" if text.strip() else "")
                print("removed LOOK hook from ~/.zshrc")
        except OSError as e:
            print(f"LOOK: could not update ~/.zshrc: {e}")
            return 1

    if not modern_hook:
        if zsh_backup and Path(zsh_backup).expanduser().exists():
            try:
                shutil.copy2(Path(zsh_backup).expanduser(),current_zsh)
                print(f"restored legacy ~/.zshrc ← {zsh_backup}")
            except OSError as e:
                print(f"LOOK: could not restore ~/.zshrc: {e}")
                return 1
        else:
            print("LOOK: no managed ~/.zshrc hook or legacy backup found; leaving ~/.zshrc untouched")

    try:
        if look_fragment.exists():
            look_fragment.unlink()
        look_dir=look_fragment.parent
        if look_dir.exists() and not any(look_dir.iterdir()):
            look_dir.rmdir()
    except OSError as e:
        print(f"LOOK: could not completely remove shell fragment: {e}")

    if remove_owned:
        brew=shutil.which("brew")
        if packages and brew:
            for pkg in packages:
                result=subprocess.run([brew,"uninstall",pkg],text=True)
                if result.returncode:
                    print(f"LOOK: brew left {pkg} installed")
        elif packages:
            print("LOOK: brew is unavailable; recorded packages were left installed.")

        # Remove deepest paths first. Never recurse outside the exact paths the
        # installer recorded as newly created by LOOK.
        for p in sorted(created_dirs,key=lambda x:len(x.parts),reverse=True):
            try:
                if p.exists():
                    shutil.rmtree(p)
                    print(f"removed {p}")
            except OSError as e:
                print(f"LOOK: could not remove {p}: {e}")

    # Preserve user secrets explicitly. Remove both launchers owned by the unified environment.
    future_launcher=HOME/".local/bin/future-crash"
    try:
        if future_launcher.is_symlink() or future_launcher.exists():
            future_launcher.unlink()
    except OSError as e:
        print(f"LOOK: could not remove {future_launcher}: {e}")

    future_state=HOME/".local/share/future-crash"
    try:
        if future_state.exists():
            shutil.rmtree(future_state)
    except OSError as e:
        print(f"LOOK: could not completely remove {future_state}: {e}")

    launcher=HOME/".local/bin/lk"
    try:
        if launcher.is_symlink() or launcher.exists():
            launcher.unlink()
    except OSError as e:
        print(f"LOOK: could not remove {launcher}: {e}")

    # The running process may safely remove its own installed source on Unix.
    try:
        if STATE_DIR.exists():
            shutil.rmtree(STATE_DIR)
    except OSError as e:
        print(f"LOOK: could not completely remove {STATE_DIR}: {e}")
        return 1

    print()
    print("LOOK + Future Crash removed. Open a new shell or run: exec zsh")
    return 0



def _prompt_secret(prompt):
    """Hidden input with LOOK's normal escape hatch."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        import getpass
        try:
            return getpass.getpass(prompt).strip(),False
        except (EOFError,KeyboardInterrupt):
            return "",True
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    chars=[]
    try:
        tty.setcbreak(fd)
        sys.stdout.write(prompt); sys.stdout.flush()
        while True:
            ch=os.read(fd,1)
            if ch in {b'\x1b',b'\x03',b'\x04'}:
                sys.stdout.write("\n"); sys.stdout.flush()
                return "",True
            if ch in {b'\r',b'\n'}:
                sys.stdout.write("\n"); sys.stdout.flush()
                return "".join(chars).strip(),False
            if ch in {b'\x7f',b'\b'}:
                if chars: chars.pop()
                continue
            text=ch.decode("utf-8","ignore")
            if text and text.isprintable(): chars.append(text)
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)

def ollama_key(args):
    """Configure the Ollama web-search key without exposing it."""
    secrets=HOME/".zsh_secrets"
    configured=bool(os.environ.get("OLLAMA_API_KEY",""))
    try:
        if secrets.exists():
            configured=configured or bool(re.search(
                r'^\s*(?:export\s+)?OLLAMA_API_KEY\s*=\s*.+$', secrets.read_text(), re.M))
    except OSError:
        pass

    if args and args[0].lower()=="status":
        print("Ollama web search key: configured" if configured
              else "Ollama web search key: not configured")
        return 0

    value,cancelled=_prompt_secret("Ollama API key (hidden) › ")
    if cancelled or not value:
        print("· cancelled")
        return 0

    try:
        text=secrets.read_text() if secrets.exists() else ""
        line="export OLLAMA_API_KEY=" + repr(value) + "\n"
        pattern=r'^\s*(?:export\s+)?OLLAMA_API_KEY\s*=.*(?:\n|$)'
        if re.search(pattern,text,re.M):
            text=re.sub(pattern,lambda _m: line,text,count=1,flags=re.M)
        else:
            if text and not text.endswith("\n"): text+="\n"
            text+=line
        tmp=secrets.with_name(secrets.name+".tmp")
        tmp.write_text(text)
        tmp.chmod(0o600)
        tmp.replace(secrets)
        secrets.chmod(0o600)
        os.environ["OLLAMA_API_KEY"]=value
    except OSError as e:
        print(f"LOOK: could not save Ollama key: {e}")
        return 1

    print("✓ Ollama web search key saved")
    print("Open a new shell, or run: source ~/.zsh_secrets")
    return 0



