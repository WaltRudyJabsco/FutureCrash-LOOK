def _command_tool():
    return {"type":"function","function":{
        "name":"run_command",
        "description":(
            "Run a shell command on the computer running LOOK. Use this in power/unsafe sessions for executing, "
            "testing, installing, inspecting, building, cleaning, or administering beyond LOOK's bounded file tools. "
            "Prefer inspection before destructive or system-wide mutation."
        ),
        "parameters":{"type":"object","properties":{
            "command":{"type":"string","description":"Shell command to execute with zsh -lc"},
            "cwd":{"type":"string","description":"Working directory; default is the LO starting workspace"},
            "timeout":{"type":"integer","description":"Timeout seconds, 1-600; default 120"}
        },"required":["command"]}
    }}

def _run_command_tool(workspace,args,profile):
    command=str(args.get("command","")).strip()
    if not command:
        return "Command tool failed: empty command"

    cwd_raw=str(args.get("cwd","") or "").strip()
    cwd=Path(cwd_raw).expanduser() if cwd_raw else workspace
    if not cwd.is_absolute():
        cwd=(workspace/cwd).resolve()
    try:
        cwd=cwd.resolve()
    except OSError:
        return f"Command tool failed: invalid cwd: {cwd}"
    if not cwd.exists() or not cwd.is_dir():
        return f"Command tool failed: cwd is not a directory: {cwd}"

    try:
        timeout=max(1,min(600,int(args.get("timeout",120) or 120)))
    except (TypeError,ValueError):
        timeout=120

    if profile=="power" and not _confirm_command(command):
        return "Command denied by user."

    shell=shutil.which("zsh")
    if not shell:
        return "Command tool failed: zsh is not available on PATH"

    try:
        proc=subprocess.run(
            [shell,"-lc",command],
            cwd=str(cwd),
            stdin=None,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
        )
        output=(proc.stdout or "").strip()
        if len(output)>16000:
            output="[output truncated to final 16000 characters]\n"+output[-16000:]
        return f"exit {proc.returncode}" + (f"\n{output}" if output else "")
    except subprocess.TimeoutExpired as exc:
        partial=exc.stdout or ""
        if isinstance(partial,bytes):
            partial=partial.decode(errors="replace")
        partial=partial.strip()
        return f"Command timed out after {timeout}s" + (f"\n{partial[-8000:]}" if partial else "")
    except OSError as exc:
        return f"Command tool failed: {exc}"

def _lo_tools(profile):
    tools=_filesystem_tools()
