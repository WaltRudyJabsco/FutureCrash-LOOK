class _RollingThinking:
    def __init__(self, mode):
        self.mode=mode
        self.lines=[]
        self.started=False
        self.buffer=""

    def feed(self,text):
        if not text or self.mode=="quiet": return
        self.buffer+=text
        # Promote readable clauses/chunks instead of repainting every token.
        while True:
            m=re.search(r"(.{35,160}?(?:[.!?]\s+|\n)|.{120,160}(?:\s+|$))",self.buffer,re.S)
            if not m: break
            chunk=" ".join(m.group(1).split()).strip()
            self.buffer=self.buffer[m.end():]
            if chunk: self._show(chunk)

    def _show(self,chunk):
        if self.mode=="full":
            if not self.started:
                print("\\n"+_ansi_label("thinking ›","2"))
                self.started=True
            print("  "+_c(chunk,"2"),flush=True)
            return
        self.lines=(self.lines+[chunk])[-3:]
        if not sys.stdout.isatty():
            print("thinking › "+chunk,flush=True); return
        if self.started:
            sys.stdout.write(f"\\033[{len(self.lines)-1 if len(self.lines)>1 else 1}A")
        else:
            print()
            self.started=True
        for line in self.lines:
            sys.stdout.write("\\r\\033[2K"+_ansi_label("thinking ›","2")+" "+_c(line[:150],"2")+"\\n")
        sys.stdout.flush()

    def finish(self):
        tail=" ".join(self.buffer.split()).strip()
        if tail and self.mode!="quiet": self._show(tail)
        if self.started: print()

