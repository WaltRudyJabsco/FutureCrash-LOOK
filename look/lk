def _skills_metadata(text):
    schema=re.search(r"<!--\s*schema:\s*(\d+)\s*-->",str(text or ""),re.I)
    bundled=re.search(r"<!--\s*bundled-version:\s*(\d+)\s*-->",str(text or ""),re.I)
    return {"schema":int(schema.group(1)) if schema else 0,
            "bundled_version":int(bundled.group(1)) if bundled else 0}


def _split_skills(text):
    marker="## Learned"
    text=str(text or "")
    if marker in text:
        head,tail=text.split(marker,1)
        return head.rstrip(),tail.strip()
    return text.rstrip(),""


def _merge_skills_pack(existing, pack):
    meta=_skills_metadata(pack)
    if meta["schema"] not in {0,SKILLS_SCHEMA_VERSION}:
        raise ValueError(f"unsupported skills schema: {meta['schema']}")
    pack_head,_=_split_skills(pack)
    _,learned=_split_skills(existing)
    out=pack_head.rstrip()+"\n\n## Learned\n\n"
    if learned:
        out+=learned.rstrip()+"\n"
    return out


def _sync_bundled_skills(pack_text=None):
