        tools=[t for t in tools if t.get("function",{}).get("name") in {"list_files","read_file","search_files"}]
    tools.extend(_information_tools())
    tools.extend(_system_inspection_tools())
    if profile in {"power","unsafe"}:
        tools.append(_command_tool())
    return tools

