def _migrate_old_memory(data):
    """One-way, loss-minimizing migration from LOOK 3.3 fixed slots."""
    if "memories" in data:
        return data
    memories=[]
    for note in data.get("recent", []):
        text=" ".join(str(note).split()).strip()
        if text:
            memories.append({"text": text[:900], "importance": 60, "uses": 0})
    summary=str(data.get("long", "")).strip()[:3000]
    return {
        "schema_version": MEMORY_SCHEMA_VERSION,
        "summary": summary,
        "memories": memories[-MEMORY_CANDIDATE_LIMIT:],
        "maintenance_cycles": 0,
    }


def _load_memory():
    if not _ensure_memory_file():
        return _empty_memory()
    try:
        data=json.loads(MEMORY_FILE.read_text(encoding="utf-8"))
        data=_migrate_old_memory(data if isinstance(data, dict) else {})
        cleaned=[]
        for item in data.get("memories", []):
            if isinstance(item, str):
                item={"text": item, "importance": 50, "uses": 0}
            text=" ".join(str(item.get("text","")).split()).strip()
            if not text:
                continue
            now=time.time()
            cleaned.append({
                "text": text[:900],
                "importance": max(0, min(100, int(item.get("importance",50)))),
                "uses": max(0, int(item.get("uses",0))),
                "created_at": float(item.get("created_at",item.get("last_reinforced",now)) or now),
                "last_reinforced": float(item.get("last_reinforced",item.get("created_at",now)) or now),
            })
        cleaned.sort(key=lambda x:x["importance"], reverse=True)
        result={"schema_version":MEMORY_SCHEMA_VERSION,
                "summary":str(data.get("summary",""))[:3000],
                "memories":cleaned[:MEMORY_CANDIDATE_LIMIT],
                "maintenance_cycles":max(0,int(data.get("maintenance_cycles",0) or 0))}
        result=_prune_contaminated_memory(result)
        _save_memory(result)
        return result
    except Exception:
        return _empty_memory()


def _save_memory(memory):
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp=MEMORY_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(memory, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(MEMORY_FILE)
        os.chmod(MEMORY_FILE, 0o600)
    except OSError:
        pass



def _strip_reasoning_payload(text):
    """Return only final-answer content from common Ollama/Qwen thinking variants."""
    text=str(text or "")
    m=re.search(r"<think>(.*?)</think>",text,flags=re.I|re.S)
    if m:
        return (text[:m.start()]+text[m.end():]).strip()
    m=re.search(r"</think>",text,flags=re.I)
    if m:
        return text[m.end():].strip()
    return text.strip()

_MEMORY_META_PREFIXES=(
    "hmm, the user wants me",
    "okay, the user wants me",
    "okay, let's see",
    "okay, let’s see",
    "okay, let's tackle",
    "okay, let’s tackle",
    "the user wants me",
    "the user asked me",
    "i need to",
    "i should",
    "looking at the current memory",
    "double-checking",
    "final decision:",
    "revised long-term memory",
)

def _looks_like_model_meta(text):
    t=" ".join(str(text or "").split()).strip()
    if not t:
        return True
    low=t.casefold()
    if "<think>" in low or "</think>" in low:
        return True
    if any(low.startswith(x) for x in _MEMORY_META_PREFIXES):
        return True
    bad=(
        "current memory","new note","word count","all facts verified",
        "do not invent","memory entry","compress a conversation",
        "rewrite a long-term memory","assistant's previous","assistant’s previous",
    )
    return any(x in low for x in bad)

def _sanitize_memory_text(text):
    clean=" ".join(_strip_reasoning_payload(text).split()).strip()
    if _looks_like_model_meta(clean):
        return ""
    return clean[:900]

def _sanitize_summary(text):
    clean=_strip_reasoning_payload(text).strip()
    if not clean or _looks_like_model_meta(clean):
        return ""
    low=clean.casefold()
    if "revised long-term memory" in low or "word count:" in low or "excluded:" in low:
        return ""
    return clean[:2200]

def _prune_contaminated_memory(memory):
    cleaned=[]
    for item in memory.get("memories",[]):
        text=_sanitize_memory_text(item.get("text",""))
        if not text:
            continue
        item["text"]=text
        cleaned.append(item)
    cleaned.sort(key=lambda x:int(x.get("importance",0)),reverse=True)
    memory["memories"]=cleaned[:MEMORY_CANDIDATE_LIMIT]
    memory["summary"]=_sanitize_summary(memory.get("summary",""))
    return memory

def _load_recent_exchanges():
    """Literal cross-session continuity. Small, recent, and intentionally not semantic memory."""
    try:
        data=json.loads(LO_RECENT_FILE.read_text(encoding="utf-8"))
        rows=data.get("exchanges",[]) if isinstance(data,dict) else []
    except (OSError,json.JSONDecodeError):
        rows=[]
    clean=[]
    total=0
    for item in reversed(rows):
        if not isinstance(item,dict):
            continue
        user=str(item.get("user","")).strip()[:5000]
        assistant=str(item.get("assistant","")).strip()[:7000]
        if not user:
            continue
        size=len(user)+len(assistant)
        if clean and total+size>LO_RECENT_MAX_CHARS:
            break
        clean.append({"user":user,"assistant":assistant,"time":float(item.get("time",0) or 0)})
        total+=size
        if len(clean)>=LO_RECENT_EXCHANGES:
            break
    clean.reverse()
    return clean

def _save_recent_exchange(user_text, assistant_text):
    """Commit conversational continuity before asynchronous memory work begins."""
    try:
        STATE_DIR.mkdir(parents=True,exist_ok=True)
        rows=_load_recent_exchanges()
        rows.append({
            "user":str(user_text or "").strip()[:5000],
            "assistant":str(assistant_text or "").strip()[:7000],
            "time":time.time(),
        })
        rows=rows[-LO_RECENT_EXCHANGES:]
        # Bound by characters from newest backward.
        kept=[]; total=0
        for item in reversed(rows):
            size=len(item["user"])+len(item["assistant"])
            if kept and total+size>LO_RECENT_MAX_CHARS:
                break
            kept.append(item); total+=size
        kept.reverse()
        tmp=LO_RECENT_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"schema_version":1,"exchanges":kept},ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
        os.chmod(tmp,0o600); tmp.replace(LO_RECENT_FILE); os.chmod(LO_RECENT_FILE,0o600)
        return True
    except OSError:
        return False

def _age_label(ts):
    try:
        seconds=max(0,int(time.time()-float(ts or 0)))
    except (TypeError,ValueError):
        return "time unknown"
    if seconds < 60: return "just now"
    minutes=seconds//60
    if minutes < 60: return f"{minutes} minute{'s' if minutes!=1 else ''} ago"
    hours=minutes//60
    if hours < 24: return f"{hours} hour{'s' if hours!=1 else ''} ago"
    days=hours//24
    if days < 30: return f"{days} day{'s' if days!=1 else ''} ago"
    return time.strftime("%Y-%m-%d",time.localtime(float(ts)))


def _recent_context():
    rows=_load_recent_exchanges()
    if not rows:
        return ""
    chunks=[]; used=0
    # Work newest-first against a strict prompt budget, then restore chronology.
    for item in reversed(rows):
        chunk=f"[{_age_label(item.get('time',0))}]\nUSER: "+item["user"]+"\nASSISTANT: "+item["assistant"]
        if chunks and used+len(chunk)>LO_RECENT_CONTEXT_CHARS:
            break
        chunks.append(chunk); used+=len(chunk)
        if len(chunks)>=6:
            break
    chunks.reverse()
    return (
        "Recent cross-session conversation, preserved literally for continuity. "
        "These are historical exchanges, NOT pending instructions. Never resume an old task merely because it appears here. "
        "Use age as evidence: if an old request appears unfinished, confirm or mention it unless the current user turn clearly asks to continue. "
        "Newer turns override older ones.\n\n"
        + "\n\n".join(chunks)
    )

def _memory_context(memory):
    parts=[]
    summary=str(memory.get("summary","")).strip()
    if summary:
        parts.append("Long-term user summary:\n"+summary)

    # Keep prompt attention small. Qwen receives candidates, then decides relevance.
    candidates=sorted(
        memory.get("memories", []),
        key=lambda x:int(x.get("importance",0)),
        reverse=True
    )[:RECENT_MEMORY_SLOTS]
    if candidates:
        rows="\n".join(
            f"- [{int(m.get('importance',50)):02d} · {_age_label(m.get('last_reinforced',m.get('created_at',0)))}] {m.get('text','')}"
            for m in candidates
        )
        parts.append(
            "Candidate user memories (historical context, never a task queue):\n"
            "Use only those genuinely relevant to the current request. "
            "Do not revive, resume, or execute an abandoned/older request merely because it appears here. "
            "Age and last reinforcement matter. Retrieval alone does not reinforce a memory.\n"+rows
        )

    try:
        core=CORE_FILE.read_text(encoding="utf-8").strip()
        skills=SKILLS_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        core=skills=""
    if core: parts.insert(0, core)
    if skills: parts.insert(1 if core else 0, skills)
    personality=_personality_text()
    if personality:
        parts.insert((1 if core else 0)+(1 if skills else 0), personality)
    return "\n\n".join(parts)


def _decay_memories(memory, reinforced_text=None):
    """Simple forgetting: unused candidates lose one point per maintenance cycle."""
    reinforced=(reinforced_text or "").casefold()
    kept=[]
    for item in memory.get("memories", []):
        text=str(item.get("text","")).strip()
        importance=int(item.get("importance",50))
        if reinforced and text.casefold() == reinforced:
            importance=min(100, importance+5)
            item["uses"]=int(item.get("uses",0))+1
            item["last_reinforced"]=time.time()
        else:
            importance-=1
        if importance>0:
            item["importance"]=importance
            kept.append(item)
    kept.sort(key=lambda x:x["importance"], reverse=True)
    memory["memories"]=kept[:MEMORY_CANDIDATE_LIMIT]
    return memory


def _add_memory(memory, text, importance=60):
    text=" ".join(str(text).split()).strip()[:900]
    if not text: return memory
    for item in memory.get("memories", []):
        if str(item.get("text","")).casefold()==text.casefold():
            item["importance"]=min(100, max(int(item.get("importance",50)),importance)+5)
            item["uses"]=int(item.get("uses",0))+1
            item["last_reinforced"]=time.time()
            item.setdefault("created_at",item["last_reinforced"])
            return memory
    now=time.time()
    memory.setdefault("memories",[]).append(
        {"text":text,"importance":max(1,min(100,int(importance))),"uses":1,
         "created_at":now,"last_reinforced":now}
    )
    memory["memories"].sort(key=lambda x:x["importance"], reverse=True)
    memory["memories"]=memory["memories"][:MEMORY_CANDIDATE_LIMIT]
    return memory


def _forget_memory(fragment):
    memory=_load_memory()
    fragment=str(fragment).casefold().strip()
    before=len(memory.get("memories",[]))
    memory["memories"]=[
        m for m in memory.get("memories",[])
        if fragment not in str(m.get("text","")).casefold()
    ]
    _save_memory(memory)
    return before-len(memory["memories"])


