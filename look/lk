        if platform.system()=="Darwin" and shutil.which("pbcopy"):
            subprocess.run(["pbcopy"],input=value,text=True,check=True)
            return True
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy"],input=value,text=True,check=True)
            return True
        if shutil.which("xclip"):
            subprocess.run(["xclip","-selection","clipboard"],input=value,text=True,check=True)
            return True
    except (OSError,subprocess.SubprocessError):
        pass
    return False


def _copy_file_clipboard(path):
    p=Path(path).expanduser().resolve()
    try:
        if platform.system()=="Darwin" and shutil.which("osascript"):
            if p.is_file():
                clipboard_class={
                    ".png":"PNGf",
                    ".jpg":"JPEG",
                    ".jpeg":"JPEG",
                    ".tif":"TIFF",
                    ".tiff":"TIFF",
                }.get(p.suffix.lower())
                if clipboard_class:
                    quoted=json.dumps(str(p))
                    script=(
                        f'set the clipboard to '
                        f'(read (POSIX file {quoted}) as «class {clipboard_class}»)'
                    )
                    subprocess.run(["osascript","-e",script],check=True,
                                   stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
                    return True

            paths_json=json.dumps([str(p)])
            script=f"""
ObjC.import('AppKit');
ObjC.import('Foundation');
const paths = {paths_json};
const pb = $.NSPasteboard.generalPasteboard;
pb.clearContents;
const urls = paths.map(p => $.NSURL.fileURLWithPath(p).js);
if (!pb.writeObjects(urls)) throw new Error('NSPasteboard writeObjects failed');
if ((pb.pasteboardItems.count * 1) < 1) throw new Error('clipboard verification failed');
"""
            subprocess.run(["osascript","-l","JavaScript","-e",script],check=True,
                           stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            return True

        uri=p.as_uri()+"\r\n"
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy","--type","text/uri-list"],input=uri,text=True,check=True)
            return True
        if shutil.which("xclip"):
            subprocess.run(["xclip","-selection","clipboard","-t","text/uri-list"],
                           input=uri,text=True,check=True)
            return True
    except (OSError,subprocess.SubprocessError):
        pass
    return False


def _open_file(path, choose=False):
    try:
        if platform.system()=="Darwin":
            if choose:
                # `open -a` needs an app name; keep LOOK's card simple and use
                # the default app here. The filesystem browser still provides
                # the richer O/open-with chooser.
                return subprocess.call(["open",str(path)])
            return subprocess.call(["open",str(path)])
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open",str(path)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            return 0
    except OSError:
        pass
    return 1


