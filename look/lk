def _profile_command(args):
    if not args or args[0] in {"status","show"}:
        return _profile_status()
    cmd=args[0]
    if cmd=="backup":
        return _profile_backup(args[1:])
    if cmd=="export":
        output=" ".join(args[1:]).strip() or None
        return _profile_export(output)
    if cmd=="restore":
        if len(args)<2:
            print("usage: lk profile restore <ZIP|BACKUP_DIR> [--yes]"); return 2
        src=args[1]
        return _profile_restore(src,args[2:])
    if cmd=="path":
        print(STATE_DIR); return 0
    if cmd=="config":
        print(CONFIG_DIR); return 0
    if cmd=="files":
        _title("profile","portable files")
        for src,rel in _profile_entries():
            print(f"  {rel}  {_c(str(src),'2')}")
        return 0
    print("usage: lk profile [status|backup [DEST]|export [ZIP]|restore SOURCE|files|path|config]")
    return 2


def _lo_context_handoff(paths):
    """Launch LO with selected filesystem paths as explicit context."""
    resolved=[]
    for raw in paths:
        p=Path(raw).expanduser().resolve()
        if p.exists():
            resolved.append(p)
    if not resolved:
        print("LOOK LO · no valid selected paths")
        return 1

    anchors=[p if p.is_dir() else p.parent for p in resolved]
    try:
        workspace=Path(os.path.commonpath([str(p) for p in anchors])).resolve()
    except ValueError:
        workspace=Path.cwd().resolve()

    # Keep the workspace a directory and ensure every selected path is reachable
    # by LOOK's bounded file tools. For a single selected directory, that directory
    # itself is the workspace; for siblings, their nearest common ancestor is used.
    return ollama_chat(
        selected_paths=resolved,
        workspace_override=workspace,
    )


def _atomic_json(path, data):
    path=Path(path)
    path.parent.mkdir(parents=True,exist_ok=True)
    tmp=path.with_suffix(path.suffix+".tmp")
    tmp.write_text(json.dumps(data,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
    try: os.chmod(tmp,0o600)
    except OSError: pass
    tmp.replace(path)

def _emit_event(kind, text, job_id=None):
    LO_EVENTS_DIR.mkdir(parents=True,exist_ok=True)
    event={
        "id":uuid.uuid4().hex[:12],
        "kind":str(kind),
        "text":str(text).strip()[:8000],
        "job_id":job_id,
        "time":time.time(),
    }
    _atomic_json(LO_EVENTS_DIR/f"{time.time_ns()}-{event['id']}.json",event)
    return event

def _events_command(args):
    drain="--drain" in args
    try:
        files=sorted(LO_EVENTS_DIR.glob("*.json"))
    except OSError:
        files=[]
    if not files:
        return 0
    for path in files:
        try:
            event=json.loads(path.read_text(encoding="utf-8"))
        except (OSError,json.JSONDecodeError):
            continue
        age=_age_label(event.get("time",0))
        kind=str(event.get("kind","event")).upper()
        _feedback("error" if kind=="FAILED" else "notify","LO event")
        text=str(event.get("text","")).strip()
        print(f"{_ansi_label('LO · '+kind,'35')} {_c('· '+age,'2')}")
        if text:
            for line in text.splitlines()[:12]:
                print("  "+line)
        if drain:
            try: path.unlink()
            except OSError: pass
    return 0

def _jobs_command(args):
    try:
        files=sorted(LO_JOBS_DIR.glob("*.json"))
    except OSError:
        files=[]
    if not files:
        print("LO jobs · none")
        return 0
    for path in files[-20:]:
        try: job=json.loads(path.read_text(encoding="utf-8"))
        except (OSError,json.JSONDecodeError): continue
        print(f"{job.get('id','?')}  {job.get('status','?'):<8}  {_age_label(job.get('created_at',0)):<14}  {job.get('prompt','')[:80]}")
    return 0

def _queue_lo_background(prompt, workspace, profile):
    prompt=str(prompt or "").strip()
    if not prompt:
        print("usage: lo bg <request>")
        return 2
    LO_JOBS_DIR.mkdir(parents=True,exist_ok=True)
    job_id=uuid.uuid4().hex[:10]
    path=LO_JOBS_DIR/f"{job_id}.json"
    job={
        "id":job_id,
        "status":"queued",
        "prompt":prompt,
        "workspace":str(Path(workspace).resolve()),
        "profile":profile,
        "created_at":time.time(),
        "started_at":None,
        "finished_at":None,
    }
    _atomic_json(path,job)
    try:
        subprocess.Popen(
            [sys.executable,str(Path(__file__).resolve()),"_lo-job",str(path)],
            stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,
            start_new_session=True,close_fds=True,
        )
    except OSError as exc:
        job["status"]="failed"; job["error"]=str(exc); job["finished_at"]=time.time(); _atomic_json(path,job)
        print(f"LO background · failed to start: {exc}")
        return 1
    print(f"LO background · queued {job_id}")
    return 0

def _run_lo_job(path):
    import io, contextlib
    path=Path(path)
    try:
        job=json.loads(path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError):
        return 1
    job["status"]="running"; job["started_at"]=time.time(); _atomic_json(path,job)
    old_cwd=Path.cwd()
    buf=io.StringIO()
    rc=1
    try:
        workspace=Path(job.get("workspace") or old_cwd).expanduser().resolve()
        os.chdir(workspace)
        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
            rc=ollama_chat(
                initial_prompt=job.get("prompt",""),
                access_profile=job.get("profile","workspace"),
                workspace_override=workspace,
                one_shot=True,
            )
        job["status"]="done" if rc==0 else "failed"
    except Exception as exc:
        job["status"]="failed"; job["error"]=str(exc)
    finally:
        try: os.chdir(old_cwd)
        except OSError: pass
    job["finished_at"]=time.time()
    output=re.sub(r"\x1b\[[0-9;?]*[A-Za-z]","",buf.getvalue()).strip()
    job["output"]=output[-12000:]
    _atomic_json(path,job)
    if job["status"]=="done":
        # Prefer the final LO line, but retain enough context to be useful.
        lines=[x.strip() for x in output.splitlines() if x.strip()]
        tail="\n".join(lines[-6:]) if lines else "completed"
        _emit_event("complete",tail,job.get("id"))
    else:
        _emit_event("failed",job.get("error") or output[-1000:] or "background job failed",job.get("id"))
    return 0 if job["status"]=="done" else 1


def main():
    if len(sys.argv)>=3 and sys.argv[1]=="_lo-job":
        return _run_lo_job(sys.argv[2])
    if len(sys.argv)>=2 and sys.argv[1]=="events":
        return _events_command(sys.argv[2:])
    if len(sys.argv)>=2 and sys.argv[1]=="jobs":
        return _jobs_command(sys.argv[2:])

    # `lk o` remains the chat verb. In v2, bare `lk ollama` is inspection;
    # adding search/a prompt keeps the historical long-form chat spelling useful.
    if len(sys.argv) >= 2 and sys.argv[1] == "_lo-context":
        return _lo_context_handoff(sys.argv[2:])

    if len(sys.argv) >= 2 and (
        sys.argv[1] == "o"
        or (
            sys.argv[1] == "ollama"
            and len(sys.argv) >= 3
            and sys.argv[2] not in {"models","test","key","host","hosts","share","access"}
        )
    ):
        args=sys.argv[2:]
        allow_start=True
        host_override=None
        host_name=None
        access_profile=None
        profile_flags={
            "--conservative":"conservative",
            "--workspace":"workspace",
            "--power":"power",
            "--unsafe":"unsafe",
        }
        while args:
            if args[0] in profile_flags:
                access_profile=profile_flags[args.pop(0)]
                continue
            if args[0] == "--no-start":
                allow_start=False
                args.pop(0)
                continue
            if args[0].startswith("@") and len(args[0])>1 and host_override is None:
                token=args.pop(0)[1:]
                host_name,host_override=_resolve_ollama_host(token)
                if not host_override:
                    print(f"LOOK OLLAMA · host not found: {token}")
                    print("  run: lk ollama host")
                    return 1
                continue
            break
        if args and args[0]=="bg":
            return _queue_lo_background(" ".join(args[1:]),Path.cwd(),access_profile or _load_lo_profile())

        force_search=bool(args and args[0] == "search")
        if force_search:
            args=args[1:]
        initial_prompt=" ".join(args).strip() or None
        return ollama_chat(
            force_search=force_search, initial_prompt=initial_prompt,
            allow_start=allow_start, host_override=host_override, host_name=host_name,
            access_profile=access_profile
        )
    a=sys.argv[1:]
    if not a: return render([])
    cmd=a[0]; rest=a[1:]
    if cmd=="_remember-worker": return _memory_worker()
    if cmd=="memory": return _memory_command(rest)
    if cmd=="forget":
        if not rest: print("usage: lk forget <text>"); return 2
        n=_forget_memory(" ".join(rest)); print(f"Removed {n} matching memory item(s)."); return 0
    if cmd=="clear-memory": return _memory_command(["clear"])
    if cmd=="skills": return _skills_command(rest)
    if cmd=="profile": return _profile_command(rest)
    if cmd=="feedback": return _feedback_command(rest)
    if cmd=="sound": return _sound_command(rest)
    if cmd=="personality": return lo_personality(rest)
    if cmd=="thinking": return lo_thinking(rest)
    if cmd in {"think-display","thinkdisplay"}: return lo_think_display(rest)
    if cmd in {"media","music"}: return media(rest)
    if cmd=="_ollama-share-proxy": return _ollama_share_proxy()
    modes={"detail":"detail","dirs":"dirs","files":"files","tree":"tree","recent":"recent","size":"size"}
    if cmd=="games": print("No games installed."); return 0
    if cmd=="ttt": return game_ttt()
    if cmd=="gtnw": return game_gtnw()
    if cmd in ("help","-h","--help"):
        if rest and rest[0]=="all": return help_screen()
        return starter_help()
    if cmd=="commands": return commands_screen()
    if cmd=="ai": return _surface_ai()
    if cmd=="system": return _surface_system()
    if cmd=="clean": return _surface_clean()
    if cmd=="models": return ollama_models(rest[0] if rest else None)
    if cmd=="benchmark": return ollama_test(all_models=("--all" in rest))
    if cmd=="web": return ollama_key(["status"] if not rest else rest)
    if cmd in ("version","--version","-V"): print(f"LOOK {VERSION}"); return 0
    if cmd=="home": return home()
    if cmd=="undo": return _undo_last()
    if cmd=="_batch":
        if len(rest)<3: return 2
        kind=rest[0]
        if kind=="remove":
            paths=rest[2:] if rest[1]=="--" else rest[1:]
            return _batch_action(kind,"",paths)
        return _batch_action(kind,rest[1],rest[2:])
    if cmd=="_copy":
        if len(rest)!=2: return 2
        result=_interactive_file_action("copy",rest[0],rest[1])
        print(_action_result(result))
        return 0 if result.startswith("COPY OK") else 1
    if cmd=="_move":
        if len(rest)!=2: return 2
        result=_interactive_file_action("move",rest[0],rest[1])
        print(_action_result(result))
        return 0 if result.startswith("MOVE OK") else 1
    if cmd=="_remove":
        if len(rest)!=1: return 2
        result=_journal_remove(rest[0])
        print(_action_result(result))
        return 0 if result.startswith("REMOVE OK") else 1
    if cmd=="_mkdir":
        if len(rest)!=1: return 2
        result=_journal_mkdir(rest[0])
        print(_action_result(result))
        return 0 if result.startswith(("MKDIR OK","Directory already exists:")) else 1
    if cmd=="_touch":
        create_missing=False
        if rest and rest[0]=="--parents":
            create_missing=True
            rest=rest[1:]
        if len(rest)!=1: return 2
        result=_journal_touch(rest[0],create_missing=create_missing)
        print(_action_result(result))
        return 0 if result.startswith("FILE OK") else 1
    if cmd=="doctor": return doctor()
    if cmd=="settings": return settings()
    if cmd=="uninstall": return uninstall()
    if cmd=="config":
        if rest and rest[0] in {"paths","raw"}:
            print(f"LOOK {VERSION}\n  executable  {Path(__file__).resolve()}\n  renderer    {RENDERER}\n  zshrc       {HOME/'.zshrc'}\n  secrets     {HOME/'.zsh_secrets'}\n  memory      {MEMORY_FILE}\n  memory queue {MEMORY_QUEUE}\n  undo        {UNDO_FILE}\n  ollama model {_preferred_ollama_model()}\n  ollama models {OLLAMA_MODELS_FILE}")
            return 0
        return _surface_config()
    if cmd=="secrets":
        p=HOME/".zsh_secrets"
        if not p.exists(): print("LOOK secrets: ~/.zsh_secrets is not present."); return 1
        mode=oct(p.stat().st_mode & 0o777)
        print(f"LOOK secrets: {p} exists · permissions {mode} · contents hidden")
        return 0 if mode=="0o600" else 1
    if cmd in modes: return render(["--mode", modes[cmd], *rest])
    if cmd in {"run","project"}: return inspect_project(rest[0] if rest else '.')
    if cmd in {"up","ports","services"}: return inspect_up()
    if cmd=="port":
        if not rest or not rest[0].isdigit(): print("usage: lk port <number>"); return 2
        port=int(rest[0]); return inspect_port(port) if 1 <= port <= 65535 else 2
    if cmd in {"processes","procs"}: return inspect_processes()
    if cmd in {"process","proc"}:
        if not rest: print("usage: lk process <name>"); return 2
        query=" ".join(rest); result=inspect_process(query)
        if result is None:
            _title(query, 'process'); print(f"  {_c('·','33')} no matching process found"); return 1
        return result
    if cmd=="pid":
        if not rest or not rest[0].isdigit(): print("usage: lk pid <number>"); return 2
        return inspect_pid(int(rest[0]))
    if cmd=="git": return inspect_git(rest[0] if rest else '.')
    if cmd in {"machine","box"}: return inspect_machine()
    if cmd=="net": return _surface_net()
    if cmd=="network": return inspect_network()
    if cmd=="tailscale": return inspect_tailscale()
    if cmd=="ollama":
        if rest and rest[0]=="key":
            return ollama_key(rest[1:])
        if rest and rest[0] in {"host","hosts"}:
            return ollama_hosts(rest[1:])
        if rest and rest[0]=="share":
            return ollama_share(rest[1:])
        if rest and rest[0]=="access":
            return lo_access(rest[1:])
        if rest and rest[0]=="models":
            return ollama_models(rest[1] if len(rest)>1 else None)
        if rest and rest[0]=="test":
            return ollama_test(all_models=("--all" in rest[1:]))
        return inspect_ollama()
    if cmd=="env": return inspect_env()
    if cmd=="path": return inspect_path()
    if cmd=="gpu": return inspect_gpu()
    if cmd=="disk": return inspect_disk()
    if cmd=="why":
        if not rest: print("usage: lk why <command>"); return 2
        return inspect_command(rest[0])
    if len(a)==1: return inspect_anything(cmd)
    return render(a)
if __name__=="__main__": raise SystemExit(main())
