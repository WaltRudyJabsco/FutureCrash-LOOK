def _local_chat_once(base, model, messages, *, num_ctx=4096, num_predict=128, think=False, temperature=0.2):
    import json
    import urllib.request
    payload=json.dumps({
        "model": model,
        "messages": messages,
        "stream": False,
        "think": think,
        "options": {
            "num_ctx": int(num_ctx),
            "num_predict": int(num_predict),
            "temperature": float(temperature),
        },
    }).encode()
    request=urllib.request.Request(
        base + "/api/chat", data=payload,
        headers={"Content-Type": "application/json"}, method="POST"
    )
    with urllib.request.urlopen(request) as response:
        result=json.load(response)
    return result.get("message", {}).get("content", "").strip()



@contextmanager
def _activity(label):
    """Show a small animated status while a synchronous Ollama step is busy."""
    interactive = sys.stdout.isatty()
    if not interactive:
        print(f"· {label}", flush=True)
        yield
        return

    stop = threading.Event()
    frames = ("◐", "◓", "◑", "◒")

    def animate():
        i = 0
        while not stop.is_set():
            frame=_c(frames[i % len(frames)], "36")
            sys.stdout.write(f"\r\033[2K{frame} {_c(label,'2')}")
            sys.stdout.flush()
            i += 1
            stop.wait(0.12)

    worker = threading.Thread(target=animate, daemon=True)
    worker.start()
    try:
        yield
    finally:
        stop.set()
        worker.join(timeout=0.5)
        sys.stdout.write("\r\033[2K")
        sys.stdout.flush()

def _extract_memory_candidate(base, model, user_text, assistant_text):
    prompt=f"""Capture the compact meat of this exchange when it would help conversational
continuity later.

Store ONE candidate memory when the user expresses a substantive preference, favorite,
habit, personal choice, project decision, active project state, unresolved task, recurring
tool/workflow preference, or explicit request to remember something.

Important guidance:
- "I like...", "I love...", "one of my favorites...", "I prefer...", "I usually...",
  "remember this", and "this is important" are normally memory-worthy.
- Recent conversational continuity matters even when a fact may not be permanent.
  Decay will handle forgetting later.
- User memory must be grounded in what the USER actually said or clearly confirmed.
  Never turn an assistant suggestion into a user preference merely because the assistant proposed it.
  A bare acknowledgement such as "nice", "thanks", or "okay" does not establish a new preference.
- Return NONE for mechanical turns, acknowledgements, disposable commands, or content-free chatter.
- Do not store assistant technique here; reusable assistant craft belongs in skills.
- Do not output analysis, reasoning, headings, or commentary.

Return exactly one line:
NONE
or:
NN|compact memory text

NN is importance 1-100.

Suggested importance:
40-59  useful recent conversational continuity
60-79  meaningful preference/project state
80-94  strong favorite/preference or recurring workflow
95-100 explicit "remember this"/"this is important" when genuinely durable

Maximum memory text: 70 words.

USER:
{user_text[:4000]}

ASSISTANT:
{assistant_text[:5000]}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"You maintain compact conversational memory. Preserve substantive continuity; decay will forget weak memories later."},
            {"role":"user","content":prompt},
        ], num_ctx=4096, num_predict=128, think=False, temperature=0.15)
        final=_strip_reasoning_payload(raw).strip()
        if final.upper()=="NONE":
            return None
        if "\n" in final.strip():
            return None
        m=re.fullmatch(r"\s*(\d{1,3})\s*\|\s*(.+?)\s*", final)
        if not m:
            return None
        text=_sanitize_memory_text(m.group(2))
        if not text:
            return None
        return max(1,min(100,int(m.group(1)))), text
    except Exception:
        return None


def _rewrite_summary(base, model, old_summary, memories):
    # Long-term consolidation happens while useful candidates are alive, not when they decay away.
    # Repetition raises importance; ordinary useful continuity can consolidate after several cycles.
    strong=[m for m in memories if int(m.get("importance",0))>=55]
    if len(strong)<2:
        return old_summary
    material="\n".join(f"- [{int(m.get('importance',0))}] {m['text']}" for m in strong[:12])
    prompt=f"""Rewrite the durable user summary using only patterns that have demonstrated
continuing value.

Return ONLY the summary itself.
No analysis. No <think> tags. No heading. No word count. No explanation of exclusions.
Maximum 180 words. Do not include transient task details. Do not invent facts.

CURRENT SUMMARY:
{old_summary or "(empty)"}

STRONG MEMORIES:
{material}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"Maintain one compact semantic long-term user summary. Output only the clean summary."},
            {"role":"user","content":prompt},
        ], num_ctx=4096, num_predict=300, think=False, temperature=0.15)
        clean=_sanitize_summary(raw)
        return clean if clean else old_summary
    except Exception:
        return old_summary


def _explicit_memory_hint(user_text):
    """Return a conservative fallback candidate for explicit user memory language."""
    text=" ".join(str(user_text or "").split()).strip()
    low=text.casefold()
    markers=(
        "remember this",
        "remember that",
        "this is important",
        "one of my favorites",
        "one of my favourite",
        "my favorite",
        "my favourite",
        "i really like",
        "i love ",
        "i prefer ",
    )
    if not any(m in low for m in markers):
        return None

    # Avoid saving commands/meta requests as a fallback.
    if len(text) < 8 or len(text) > 500:
        return None

    importance=95 if ("remember this" in low or "remember that" in low or "this is important" in low) else 82
    cleaned=_sanitize_memory_text(text)
    if not cleaned:
        return None
    return importance, cleaned


def _learned_skills():
    _ensure_intelligence_files()
    try:
        text=SKILLS_FILE.read_text(encoding="utf-8")
    except OSError:
        return []
    marker="## Learned"
