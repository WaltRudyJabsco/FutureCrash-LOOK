@contextmanager
def _game_terminal():
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise RuntimeError("games require an interactive terminal")
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[?1049h\033[?25l\033[2J\033[H")
        sys.stdout.flush()
        yield fd
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()


def _game_key(fd, timeout=None):
    key=_read_tty_key(fd,timeout)
    return key.lower() if isinstance(key,str) else key


def _ttt_winner(board):
    lines=((0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6))
    for a,b,c in lines:
        if board[a] and board[a]==board[b]==board[c]:
            return board[a]
    return "D" if all(board) else None


def _ttt_score(board, ai_turn):
    result=_ttt_winner(board)
    if result=="O": return 10
    if result=="X": return -10
    if result=="D": return 0
    if ai_turn:
        best=-99
        for i,v in enumerate(board):
            if not v:
                board[i]="O"; best=max(best,_ttt_score(board,False)); board[i]=""
        return best
    best=99
    for i,v in enumerate(board):
        if not v:
            board[i]="X"; best=min(best,_ttt_score(board,True)); board[i]=""
    return best


def _ttt_ai(board):
    # Perfect, but varied among equally good moves so repeat games do not feel scripted.
    import random
    scored=[]
    for i,v in enumerate(board):
        if not v:
            board[i]="O"; score=_ttt_score(board,False); board[i]=""
            scored.append((score,i))
    if not scored: return None
    best=max(x[0] for x in scored)
    return random.choice([i for score,i in scored if score==best])


def _ttt_screen(board, notice="YOUR MOVE", draws=0):
    blue="\033[38;5;45m"; dim="\033[38;5;31m"; bright="\033[1;38;5;51m"; reset="\033[0m"
    def cell(i):
        v=board[i]
        if v=="X": return bright+"X"+blue
        if v=="O": return "\033[1;38;5;39mO"+blue
        return " "
    rows=[]
    for r in range(3):
        a,b,c=(r*3,r*3+1,r*3+2)
        rows.append(f"       {cell(a)}       │       {cell(b)}       │       {cell(c)}")
        if r<2: rows.append("   ────────────┼───────────────┼────────────")
    out=[
        "\033[2J\033[H", bright,
        "                 TIC-TAC-TOE", reset,"", blue,
        *rows, reset,"",
        f"                 {notice}","",
        dim+"        7 8 9     or     U I O",
        "        4 5 6            J K L",
        "        1 2 3            M , ."+reset,
        "",dim+"              r restart   esc exit"+reset,
    ]
    if draws>=2:
        out += ["",dim+f"                  draws {draws}"+reset]
    sys.stdout.write("\n".join(out)); sys.stdout.flush()


def game_ttt():
    try:
        with _game_terminal() as fd:
            board=[""]*9; draws=0; notice="YOUR MOVE"
            keymap={
                "7":0,"8":1,"9":2,"4":3,"5":4,"6":5,"1":6,"2":7,"3":8,
                "u":0,"i":1,"o":2,"j":3,"k":4,"l":5,"m":6,",":7,".":8,
            }
            while True:
                _ttt_screen(board,notice,draws)
                key=_game_key(fd)
                if key=="esc": return 0
                if key=="r": board=[""]*9; notice="YOUR MOVE"; continue
                move=keymap.get(key)
                if move is None or board[move]:
                    notice="ILLEGAL MOVE" if move is not None else "YOUR MOVE"
                    continue
                board[move]="X"
                result=_ttt_winner(board)
                if result:
                    if result=="D":
                        draws+=1; notice="DRAW"
                    else: notice="YOU WIN"
                else:
                    notice="THINKING"
                    _ttt_screen(board,notice,draws); time.sleep(0.18)
                    ai=_ttt_ai(board)
                    if ai is not None: board[ai]="O"
                    result=_ttt_winner(board)
                    notice="DRAW" if result=="D" else ("COMPUTER WINS" if result=="O" else "YOUR MOVE")
                    if result=="D": draws+=1
                if result:
                    _ttt_screen(board,notice,draws)
                    time.sleep(0.25)
                    if draws>=3:
                        sys.stdout.write("\n\033[1;38;5;45m          STRANGE GAME.\n\n       NO ADVANTAGE DISCOVERED.\033[0m")
                        sys.stdout.flush()
                    while True:
                        k=_game_key(fd)
                        if k=="esc": return 0
                        if k in {"r"," ","enter","\r","\n"}:
                            board=[""]*9; notice="YOUR MOVE"; break
    except RuntimeError as exc:
        print(f"LOOK game · {exc}"); return 1


