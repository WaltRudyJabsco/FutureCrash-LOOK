#compdef lk
# LOOK context-sensitive completion.

_look_saved_hosts() {
  local file="$HOME/.local/share/look/ollama_hosts.json"
  [[ -r "$file" ]] || { print -l local; return; }
  python3 - "$file" 2>/dev/null <<'PY'
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    print("local")
    for name in sorted((d.get("hosts") or {}).keys()):
        if name != "local":
            print(name)
except Exception:
    print("local")
PY
}

_lk() {
  local context state line
  typeset -A opt_args

  local -a top
  top=(
    'detail:detailed filesystem view'
    'dirs:directories only'
    'files:files only'
    'tree:tree view'
    'recent:newest first'
    'size:size-oriented view'
    'run:project/action view'
    'up:list listening services'
    'ports:list listening ports'
    'port:inspect a port'
    'process:find a process'
    'processes:browse processes'
    'pid:inspect process ID'
    'git:repository status'
    'machine:machine capabilities'
    'gpu:GPU information'
    'disk:disk usage'
    'net:network addresses'
    'tailscale:tailnet status'
    'env:environment'
    'path:PATH diagnostics'
    'why:explain command resolution'
    'ollama:Ollama models/hosts/search/access'
    'media:system media transport'
    'memory:LO user memory'
    'forget:forget matching user memory'
    'clear-memory:clear LO user memory'
    'skills:LO assistant craft'
    'profile:portable LOOK identity'
    'ai:Living AI broker'
    'feedback:terminal motion/sound feedback'
    'sound:toggle feedback sound'
    'personality:LO personality'
    'thinking:LO thinking depth'
    'think-display:LO thinking presentation'
    'settings:unified settings panel'
    'home:LOOK home'
    'doctor:diagnose environment'
    'config:installed paths/state'
    'secrets:secret status'
    'undo:undo last safe filesystem action'
    'uninstall:remove owned files'
    'version:print version'
    'help:command glossary'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'LOOK command' top
    _files
    return
  fi

  case "$words[2]" in
    ollama)
      local -a sub
      sub=(
        'models:model panel'
        'test:benchmark model'
        'host:manage Ollama hosts'
        'share:Tailscale Ollama share'
        'key:web-search key'
        'access:LO capability profile'
      )
      if (( CURRENT == 3 )); then
        _describe -t ollama 'Ollama command' sub
        return
      fi
      case "$words[3]" in
        host)
          if (( CURRENT == 4 )); then
            local -a hosts
            hosts=("${(@f)$(_look_saved_hosts)}")
            _describe -t hosts 'saved Ollama host' hosts
            _values 'host action' forget
            return
          elif [[ "$words[4]" == "forget" && CURRENT == 5 ]]; then
            local -a hosts
            hosts=("${(@f)$(_look_saved_hosts)}")
            _describe -t hosts 'saved Ollama host' hosts
            return
          fi
          ;;
        share)
          (( CURRENT == 4 )) && _values 'share action' status off
          return
          ;;
        key)
          (( CURRENT == 4 )) && _values 'key action' status
          return
          ;;
        access)
          (( CURRENT == 4 )) && _values 'access profile' conservative workspace power unsafe
          return
          ;;
        test)
          (( CURRENT == 4 )) && _values 'test option' --all
          return
          ;;
      esac
      ;;
    personality)
      (( CURRENT == 3 )) && _values 'personality' lo robot max philosopher
      return
      ;;
    thinking)
      (( CURRENT == 3 )) && _values 'thinking depth' light adaptive deep
      return
      ;;
    think-display|thinkdisplay)
      (( CURRENT == 3 )) && _values 'think display' compact full quiet
      return
      ;;
    media|music)
      (( CURRENT == 3 )) && _values 'media action' status toggle next prev stop
      return
      ;;
    memory)
      (( CURRENT == 3 )) && _values 'memory action' add forget clear clear-summary clear-recent prune
      return
      ;;
    skills)
      (( CURRENT == 3 )) && _values 'skills action' add forget clear-learned path state version update export
      if [[ "$words[3]" == "export" && CURRENT -ge 4 ]]; then
        _files
      fi
      return
      ;;
    ai)
      (( CURRENT == 3 )) && _values 'AI action' status start stop wake
      return
      ;;
    profile)
      if (( CURRENT == 3 )); then
        _values 'profile action' status backup export restore files path config
        return
      fi
      case "$words[3]" in
        backup)
          _arguments '*:backup destination:_files -d' '--keep[retained snapshot count]:count:'
          return
          ;;
        export)
          _files
          return
          ;;
        restore)
          _files
          return
          ;;
      esac
      ;;
    feedback)
      if (( CURRENT == 3 )); then
        _values 'feedback action' status sound motion demo
        return
      fi
      if [[ "$words[3]" == "sound" && CURRENT == 4 ]]; then
        _values 'sound state' on off
        return
      fi
      if [[ "$words[3]" == "motion" && CURRENT == 4 ]]; then
        _values 'motion state' off subtle normal
        return
      fi
      ;;
    sound)
      (( CURRENT == 3 )) && _values 'sound state' on off
      return
      ;;
    port|pid)
      _message 'number'
      return
      ;;
    process|why|forget)
      _message 'text'
      return
      ;;
    detail|dirs|files|tree|recent|size|run|git)
      _files
      return
      ;;
  esac
}
